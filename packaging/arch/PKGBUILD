prepare() {
  cd "$srcdir/nacre"
  git submodule init
  git config submodule.deps/orient.url "$srcdir/orient"
  git -c protocol.file.allow=always submodule update
}

build() {
  cd "$srcdir/nacre"
  python -m build --wheel --no-isolation nacre/shell-cli
  python packaging/arch/build.py "$PWD" "$srcdir/artifacts" "$srcdir"
}

check() {
  cd "$srcdir/nacre"
  cargo test --locked --quiet
  cargo build --locked --examples
  npm ci --ignore-scripts --no-audit --no-fund
  python -m venv --system-site-packages "$srcdir/check-env"
  "$srcdir/check-env/bin/python" -m installer nacre/shell-cli/dist/*.whl
  local check_runtime
  check_runtime=$(mktemp -d)
  chmod 700 "$check_runtime"
  export NACRE_HELPER_BINARY="$PWD/target/release/nacre-helper"
  export NACRE_ORIENT_BINARY=/usr/bin/orient
  XDG_RUNTIME_DIR="$check_runtime" CI=1 dbus-run-session -- xvfb-run -a "$srcdir/check-env/bin/python" tools/check.py </dev/null
  rm -rf "$check_runtime"
}

package_nacre() {
  depends=('python' 'python-pillow' 'orient=0.1.0dev6' 'quickshell' 'hyprland' 'uwsm' 'fish' 'kitty' 'fastfetch' 'dolphin' 'kio-extras' 'qt6ct' 'breeze' 'kconfig' 'kcolorscheme' 'gtk3' 'hypridle' 'hyprlock' 'grim' 'slurp' 'wl-clipboard' 'libnotify' 'brightnessctl' 'ffmpeg' 'fontconfig' 'librsvg' 'qt6-imageformats' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'ddcutil' 'wtype' 'papirus-icon-theme' 'networkmanager' 'bluez' 'pipewire' 'wireplumber' 'xdg-utils' 'rofi' 'kwallet-pam' 'polkit-gnome' 'cliphist' 'qt6-base' 'glibc' 'python-gobject' 'libgweather-4' 'geoclue' 'bash' 'jq' 'qt6-declarative' 'libgcc' 'libstdc++' 'glib2')
  optdepends=('nacre-niri: Niri companion with native overview hover titles' 'nacre-ai: optional assistant workspace' 'nacre-brain: optional private Markdown knowledge library')
  cd "$srcdir/nacre"
  python -m installer --destdir="$pkgdir" nacre/shell-cli/dist/*.whl
  python packaging/arch/stage.py "$PWD" "$pkgdir" core "$srcdir/artifacts"
}

package_nacre-ai() {
  pkgdesc='Optional assistant workspace (no bundled providers or accounts)'
  arch=('any')
  depends=("nacre=$pkgver" 'python' 'python-gobject' 'python-dbus' 'libsecret' 'openssh' 'tmux' 'kitty' 'bash')
  optdepends=('nacre-brain: private knowledge helpers')
  cd "$srcdir/nacre"
  python packaging/arch/stage.py "$PWD" "$pkgdir" ai "$srcdir/artifacts"
}

package_nacre-brain() {
  pkgdesc='Optional private Markdown knowledge library'
  arch=('any')
  depends=("nacre=$pkgver" 'python' 'python-pillow' 'python-yaml' 'python-gobject' 'python-dbus' 'libsecret' 'bash')
  optdepends=('chromium: app-window browser for Brain' 'obsidian: alternate Markdown vault editor')
  cd "$srcdir/nacre"
  python packaging/arch/stage.py "$PWD" "$pkgdir" brain "$srcdir/artifacts"
}
