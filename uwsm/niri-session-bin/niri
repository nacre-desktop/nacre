#!/bin/sh
# UWSM's niri-session wrapper retains ownership; overlay only its compositor child.
if [ "${1:-}" = --session ]; then
    exec "$HOME/.local/share/nacre/shell/tools/nacre-helper" niri-session-runtime compositor
fi
# Native queries and offline validation must never accidentally start a session.
if [ "${NACRE_NIRI_FORK:-0}" = 1 ]; then
    fork=/usr/bin/nacre-niri
    version=$("$fork" --version 2>/dev/null) || {
        echo "nacre-niri fork was selected but its binary could not be verified" >&2
        exit 1
    }
    case "$version" in
        *"(nacre-niri)") exec "$fork" "$@" ;;
        *)
            echo "nacre-niri fork was selected but its version identity did not match" >&2
            exit 1
            ;;
    esac
fi
exec /usr/bin/niri "$@"
