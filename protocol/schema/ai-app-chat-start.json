{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatStart",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "account": {
      "description": "Profile id as listed in `ai.accounts`; the active profile when absent.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    }
  },
  "additionalProperties": false,
  "required": [
    "provider",
    "project"
  ]
}
