{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WindowFocus",
  "type": "object",
  "properties": {
    "output": {
      "description": "Optional guard: when present the window must be on this output. Absent\nmeans output-agnostic (the window's own output is used).",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "window": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false,
  "required": [
    "window"
  ]
}
