{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DashboardExtrasCall",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "focus.start"
        },
        "p": {
          "$ref": "#/$defs/FocusStart"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "focus.pause"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "focus.resume"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "focus.stop"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "clipboard.copy"
        },
        "p": {
          "$ref": "#/$defs/EntityTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "clipboard.clear"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "screenshots.open"
        },
        "p": {
          "$ref": "#/$defs/EntityTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "ai.usage.refresh"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    }
  ],
  "$defs": {
    "FocusStart": {
      "type": "object",
      "properties": {
        "minutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 180
        }
      },
      "additionalProperties": false,
      "required": [
        "minutes"
      ]
    },
    "Refresh": {
      "type": "object"
    },
    "EntityTarget": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "EntityId": {
      "description": "Opaque daemon-issued identifier. Never interpret as a path, address or command.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
    }
  }
}
