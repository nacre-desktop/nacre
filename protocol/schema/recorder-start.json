{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecorderStart",
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "#/$defs/RecorderMode"
    },
    "audio": {
      "description": "What to record besides the picture; absent means no sound (the control-centre tile).",
      "anyOf": [
        {
          "$ref": "#/$defs/RecorderAudio"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "mode"
  ],
  "$defs": {
    "RecorderMode": {
      "oneOf": [
        {
          "description": "Interactive area selection (slurp), as the QML \"record\" action.",
          "type": "string",
          "const": "region"
        },
        {
          "description": "The focused output.",
          "type": "string",
          "const": "screen"
        }
      ]
    },
    "RecorderAudio": {
      "oneOf": [
        {
          "description": "No sound.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The default output's monitor.",
          "type": "string",
          "const": "system"
        },
        {
          "description": "The default output and the default microphone mixed.",
          "type": "string",
          "const": "mixed"
        }
      ]
    }
  }
}
