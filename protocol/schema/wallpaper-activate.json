{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WallpaperActivate",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "description": "Optional catalogue source id. When present the daemon selects this item,\nafter checking the active revision and that the id is in the catalogue.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "revision"
  ]
}
