{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingsProviderWrite",
  "description": "Existing helper-owned fields in six Settings stores, never arbitrary paths.",
  "type": "object",
  "properties": {
    "store": {
      "type": "string",
      "pattern": "^(colors|wallpaper-picker|dashboard|cli|apps|launcher-workflows)$"
    },
    "value": true,
    "rev": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "store",
    "value",
    "rev"
  ]
}
