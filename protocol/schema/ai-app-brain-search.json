{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrainSearch",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 50,
      "default": 10
    }
  },
  "additionalProperties": false,
  "required": [
    "query"
  ]
}
