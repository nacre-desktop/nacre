{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OsdEvent",
  "description": "`value` is a level fraction (volume may exceed 1) or 1/0 for the two toggles.",
  "type": "object",
  "properties": {
    "kind": {
      "$ref": "#/$defs/OsdKind"
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "format": "double",
      "minimum": 0.0
    },
    "max": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1,
      "maximum": 65535
    },
    "muted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "device": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "ts": {
      "description": "Unix milliseconds when the change was observed.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "ts"
  ],
  "$defs": {
    "OsdKind": {
      "oneOf": [
        {
          "description": "Default output volume or mute. `label` is the output's description.",
          "type": "string",
          "const": "volume"
        },
        {
          "description": "The default output device changed. Carries the new device's level too.",
          "type": "string",
          "const": "output"
        },
        {
          "description": "Default input volume or mute.",
          "type": "string",
          "const": "microphone"
        },
        {
          "description": "Display brightness; `device` is the output name.",
          "type": "string",
          "const": "brightness"
        },
        {
          "description": "Keyboard backlight; `max` is the number of steps.",
          "type": "string",
          "const": "keyboard"
        },
        {
          "description": "`value` 1 on, 0 off.",
          "type": "string",
          "const": "night_light"
        },
        {
          "description": "`label` is `power-saver`, `balanced` or `performance`.",
          "type": "string",
          "const": "power_profile"
        },
        {
          "description": "`value` 1 on, 0 off.",
          "type": "string",
          "const": "capslock"
        }
      ]
    }
  }
}
