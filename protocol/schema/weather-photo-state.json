{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "ready": {
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ]
    },
    "asset": {
      "anyOf": [
        {
          "$ref": "#/$defs/Asset"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "enabled",
    "ready",
    "status"
  ],
  "$defs": {
    "Status": {
      "type": "string",
      "enum": [
        "disabled",
        "idle",
        "paused",
        "waiting_location",
        "loading",
        "ready",
        "unavailable"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "latitude": {
          "type": "number",
          "format": "double",
          "minimum": -90.0,
          "maximum": 90.0
        },
        "longitude": {
          "type": "number",
          "format": "double",
          "minimum": -180.0,
          "maximum": 180.0
        }
      },
      "required": [
        "city",
        "latitude",
        "longitude"
      ]
    },
    "Asset": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Absolute path below the user's daemon weather-photo cache; never a URL.",
          "type": "string",
          "maxLength": 4096
        },
        "checked": {
          "description": "Unix seconds; also the decoded-image cache version.",
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 9007199254740991.0
        },
        "author": {
          "type": "string",
          "maxLength": 160
        },
        "license": {
          "type": "string",
          "maxLength": 40
        },
        "source": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "path",
        "checked",
        "author",
        "license",
        "source"
      ]
    }
  }
}
