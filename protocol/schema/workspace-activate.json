{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceActivate",
  "type": "object",
  "properties": {
    "output": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceTarget"
    }
  },
  "additionalProperties": false,
  "required": [
    "output",
    "workspace"
  ],
  "$defs": {
    "WorkspaceTarget": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "integer",
          "format": "uint16",
          "minimum": 1,
          "maximum": 255
        }
      ]
    }
  }
}
