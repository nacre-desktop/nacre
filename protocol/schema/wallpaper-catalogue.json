{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WallpaperCatalogue",
  "description": "Lease-only wallpaper picker catalogue. Thumbnail paths refer to the helper's\nbounded cache and are empty when a cached thumbnail is not available.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WallpaperCatalogueEntry"
      },
      "maxItems": 2048
    }
  },
  "required": [
    "entries"
  ],
  "$defs": {
    "WallpaperCatalogueEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "$ref": "#/$defs/WallpaperKind"
        },
        "animated": {
          "description": "True for animated images (currently animated GIFs); video remains `kind: video`.",
          "type": "boolean",
          "default": false
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "thumbnail": {
          "description": "JPEG, at most 640x400 and 256 KiB, in the 128-entry `$XDG_CACHE_HOME/nacre/wallpaper-media/` thumbnail cache.",
          "type": "string",
          "maxLength": 4096
        },
        "preview": {
          "description": "JPEG, at most 1600x1000 and 2 MiB, in the same bounded cache; empty if unavailable.",
          "type": "string",
          "maxLength": 4096
        },
        "active": {
          "type": "boolean"
        },
        "palette": {
          "description": "Cached wallpaper-derived palette, present only when its marker validates.",
          "anyOf": [
            {
              "$ref": "#/$defs/WallpaperCataloguePalette"
            },
            {
              "type": "null"
            }
          ]
        },
        "video_predecode": {
          "anyOf": [
            {
              "$ref": "#/$defs/WallpaperVideoPredecode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "thumbnail",
        "preview",
        "active"
      ]
    },
    "WallpaperKind": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    },
    "WallpaperCataloguePalette": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/PaletteMode"
        },
        "colours": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 64,
          "required": [
            "background",
            "onSurface",
            "primary"
          ],
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      },
      "required": [
        "mode",
        "colours"
      ]
    },
    "PaletteMode": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ]
    },
    "WallpaperVideoPredecode": {
      "description": "A validated video source and its already extracted, still poster for early decode.",
      "type": "object",
      "properties": {
        "poster_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[^\\u0000]*$"
        },
        "poster_file_identity": {
          "$ref": "#/$defs/WallpaperFileIdentity"
        },
        "source_file_identity": {
          "$ref": "#/$defs/WallpaperFileIdentity"
        }
      },
      "required": [
        "poster_path",
        "poster_file_identity",
        "source_file_identity"
      ]
    },
    "WallpaperFileIdentity": {
      "description": "Stable metadata tuple for a bounded local file read. Consumers compare it\nbefore and after decoding through the same open file descriptor.",
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "inode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtime_sec": {
          "type": "integer",
          "format": "int64",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "mtime_nsec": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 999999999
        },
        "ctime_sec": {
          "type": "integer",
          "format": "int64",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ctime_nsec": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 999999999
        }
      },
      "required": [
        "device",
        "inode",
        "size",
        "mtime_sec",
        "mtime_nsec",
        "ctime_sec",
        "ctime_nsec"
      ]
    }
  }
}
