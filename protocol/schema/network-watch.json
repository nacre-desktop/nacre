{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetworkWatch",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "required": [
    "available",
    "generation"
  ]
}
