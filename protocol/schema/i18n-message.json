{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message",
  "description": "Plain text, or `{one, other}` forms selected by a `count` argument. Texts use\n`{name}` placeholders the shell substitutes; pseudo text arrives already\ntransformed.",
  "anyOf": [
    {
      "type": "string",
      "maxLength": 1024
    },
    {
      "$ref": "#/$defs/Plural"
    }
  ],
  "$defs": {
    "Plural": {
      "type": "object",
      "properties": {
        "one": {
          "type": "string",
          "maxLength": 1024
        },
        "other": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "required": [
        "one",
        "other"
      ]
    }
  }
}
