{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiResume",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9-]*$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "channel",
    "key"
  ]
}
