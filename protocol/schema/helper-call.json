{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HelperCall",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/HelperRequest"
        }
      },
      "required": [
        "request"
      ],
      "not": {
        "required": [
          "file"
        ]
      }
    },
    {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "not": {
        "required": [
          "request"
        ]
      }
    }
  ],
  "$defs": {
    "HelperRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tool": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        },
        "input": true
      },
      "required": [
        "id",
        "tool",
        "arguments"
      ]
    }
  }
}
