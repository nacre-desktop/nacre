{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiProvider",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9-]*$"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    }
  },
  "required": [
    "channel",
    "provider"
  ],
  "$defs": {
    "Provider": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    }
  }
}
