{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatsPage",
  "type": "object",
  "properties": {
    "offset": {
      "description": "0 (default) collects the history again; larger values page the last collection.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "maximum": 100000,
      "default": 0
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 100,
      "default": 30
    }
  },
  "additionalProperties": false
}
