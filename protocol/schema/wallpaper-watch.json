{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WallpaperWatch",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "generations": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "required": [
    "available",
    "generations"
  ]
}
