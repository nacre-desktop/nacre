{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreCall",
  "description": "Reserved method payloads embedded in call.m / call.p. No backend is registered.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "notifications.set_dnd"
        },
        "p": {
          "$ref": "#/$defs/NotificationDnd"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "notifications.dismiss"
        },
        "p": {
          "$ref": "#/$defs/NotificationDismiss"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "notifications.clear"
        },
        "p": {
          "$ref": "#/$defs/NotificationClear"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "notifications.invoke_action"
        },
        "p": {
          "$ref": "#/$defs/NotificationActionCall"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "notifications.set_hover"
        },
        "p": {
          "$ref": "#/$defs/NotificationHover"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "notifications.set_inhibited"
        },
        "p": {
          "$ref": "#/$defs/NotificationInhibited"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "network.set_wifi"
        },
        "p": {
          "$ref": "#/$defs/WifiPower"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "network.connect"
        },
        "p": {
          "$ref": "#/$defs/NetworkConnect"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "network.disconnect"
        },
        "p": {
          "$ref": "#/$defs/DeviceTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "network.forget"
        },
        "p": {
          "$ref": "#/$defs/ConnectionTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "bluetooth.set_power"
        },
        "p": {
          "$ref": "#/$defs/BluetoothPower"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "bluetooth.set_discovery"
        },
        "p": {
          "$ref": "#/$defs/BluetoothDiscovery"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "bluetooth.connect"
        },
        "p": {
          "$ref": "#/$defs/DeviceTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "bluetooth.disconnect"
        },
        "p": {
          "$ref": "#/$defs/DeviceTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "bluetooth.pair"
        },
        "p": {
          "$ref": "#/$defs/DeviceTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "bluetooth.pair.respond"
        },
        "p": {
          "$ref": "#/$defs/BluetoothPairRespond"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "bluetooth.pair.cancel"
        },
        "p": {
          "$ref": "#/$defs/DeviceTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "power.set_profile"
        },
        "p": {
          "$ref": "#/$defs/ProfileTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "audio.set_default"
        },
        "p": {
          "$ref": "#/$defs/AudioTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "audio.set_volume"
        },
        "p": {
          "$ref": "#/$defs/AudioVolume"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "audio.set_mute"
        },
        "p": {
          "$ref": "#/$defs/AudioMute"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "audio.route"
        },
        "p": {
          "$ref": "#/$defs/AudioRoute"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "dashboard.weather.refresh"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "dashboard.updates.refresh"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "dashboard.calendar.refresh"
        },
        "p": {
          "$ref": "#/$defs/Refresh"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "player.play_pause"
        },
        "p": {
          "$ref": "#/$defs/PlayerTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "player.next"
        },
        "p": {
          "$ref": "#/$defs/PlayerTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "player.previous"
        },
        "p": {
          "$ref": "#/$defs/PlayerTarget"
        }
      },
      "required": [
        "m",
        "p"
      ]
    },
    {
      "type": "object",
      "properties": {
        "m": {
          "type": "string",
          "const": "player.seek"
        },
        "p": {
          "$ref": "#/$defs/PlayerSeek"
        }
      },
      "required": [
        "m",
        "p"
      ]
    }
  ],
  "$defs": {
    "NotificationDnd": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "NotificationDismiss": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "forget": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ]
    },
    "EntityId": {
      "description": "Opaque daemon-issued identifier. Never interpret as a path, address or command.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
    },
    "NotificationClear": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/NotificationClearScope"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope"
      ]
    },
    "NotificationClearScope": {
      "type": "string",
      "enum": [
        "history",
        "retained",
        "popups"
      ]
    },
    "NotificationActionCall": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "action": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "action"
      ]
    },
    "NotificationHover": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/EntityId"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hovered": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "hovered"
      ]
    },
    "NotificationInhibited": {
      "type": "object",
      "properties": {
        "inhibited": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "inhibited"
      ]
    },
    "WifiPower": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "NetworkConnect": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/EntityId"
        },
        "target": {
          "$ref": "#/$defs/NetworkTarget"
        },
        "secret": {
          "description": "N0042: sent once, handed to NetworkManager and never stored, echoed or logged.\nValid for `access_point` and `hidden_ssid` targets only.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "security": {
          "description": "Only for `hidden_ssid`; defaults to `wpa_psk` with a secret, otherwise `open`.",
          "anyOf": [
            {
              "$ref": "#/$defs/WifiSecurity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device",
        "target"
      ]
    },
    "NetworkTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "access_point"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "connection"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "description": "N0042: join a hidden network; `id` is the SSID text (1..32 bytes), not an entity ID.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hidden_ssid"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "WifiSecurity": {
      "description": "Security for a hidden SSID with a secret; access points derive it from their flags.",
      "type": "string",
      "enum": [
        "open",
        "wpa_psk",
        "sae"
      ]
    },
    "DeviceTarget": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "device"
      ]
    },
    "ConnectionTarget": {
      "type": "object",
      "properties": {
        "connection": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "connection"
      ]
    },
    "BluetoothPower": {
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/EntityId"
        },
        "powered": {
          "type": "boolean"
        }
      },
      "required": [
        "adapter",
        "powered"
      ]
    },
    "BluetoothDiscovery": {
      "description": "N0047: start or stop discovery on one adapter. A started discovery stops by itself after a\nfixed time, so a UI that goes away never leaves the radio scanning.",
      "type": "object",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/EntityId"
        },
        "discovering": {
          "type": "boolean"
        }
      },
      "required": [
        "adapter",
        "discovering"
      ]
    },
    "BluetoothPairRespond": {
      "description": "N0045: the answer to the current pairing prompt. `pin` (kind `pin`, 1..16 printable ASCII\ncharacters) and `passkey` (kind `passkey`, 0..999999) are secrets: used once, never\nstored, echoed or logged. `accept:false` rejects and carries neither.",
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/EntityId"
        },
        "accept": {
          "type": "boolean"
        },
        "pin": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 16
        },
        "passkey": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "maximum": 999999
        }
      },
      "required": [
        "device",
        "accept"
      ]
    },
    "ProfileTarget": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "profile"
      ]
    },
    "AudioTarget": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "node"
      ]
    },
    "AudioVolume": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/EntityId"
        },
        "volume": {
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "node",
        "volume"
      ]
    },
    "AudioMute": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/EntityId"
        },
        "muted": {
          "type": "boolean"
        }
      },
      "required": [
        "node",
        "muted"
      ]
    },
    "AudioRoute": {
      "type": "object",
      "properties": {
        "stream": {
          "$ref": "#/$defs/EntityId"
        },
        "target": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "stream",
        "target"
      ]
    },
    "Refresh": {
      "type": "object"
    },
    "PlayerTarget": {
      "type": "object",
      "properties": {
        "player": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "player"
      ]
    },
    "PlayerSeek": {
      "description": "Absolute seek on the player's current track; the daemon refuses it unless the\ntopic reports `can_seek` and a known length, and clamps nothing silently.",
      "type": "object",
      "properties": {
        "player": {
          "$ref": "#/$defs/EntityId"
        },
        "position_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "player",
        "position_ms"
      ]
    }
  }
}
