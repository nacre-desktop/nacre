{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiSend",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    },
    "attachments": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object"
      },
      "default": []
    }
  },
  "required": [
    "channel",
    "text"
  ]
}
