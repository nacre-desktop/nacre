{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WidthsStatus",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "opening_width": {
      "type": "number",
      "format": "double",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "relaxed": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "available",
    "opening_width",
    "relaxed"
  ]
}
