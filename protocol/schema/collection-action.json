{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CollectionAction",
  "type": "object",
  "properties": {
    "output": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "$ref": "#/$defs/CollectionOperation"
    }
  },
  "additionalProperties": false,
  "required": [
    "output",
    "action"
  ],
  "$defs": {
    "CollectionOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
