              "type": [
                "string",
                "null"
              ],
              "maxLength": 64,
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "operation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "rename"
            },
            "collection": {
              "type": "string",
              "minLength": 17,
              "maxLength": 40
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64,
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "collection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "set_wallpaper"
            },
            "collection": {
              "type": "string",
              "minLength": 17,
              "maxLength": 40
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "collection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "set_accent"
            },
            "collection": {
              "type": "string",
              "minLength": 17,
              "maxLength": 40
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "collection",
            "enabled"
          ]
        }
      ]
    }
  }
