            },
            "collection": {
              "type": "string",
              "minLength": 17,
              "maxLength": 40
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "collection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
