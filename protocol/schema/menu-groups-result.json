{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MenuGroupsResult",
  "type": "object",
  "properties": {
    "catalog_rev": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "groups": {
      "description": "Catalog order is the default rail order; ordering and hiding stay with the caller.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MenuGroup"
      },
      "maxItems": 64
    }
  },
  "required": [
    "catalog_rev",
    "groups"
  ],
  "$defs": {
    "MenuGroup": {
      "description": "One top-level launcher group (category rail entry), localized like menu rows.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Route ID accepted by `menu.query` `route` (for example `style`).",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "icon": {
          "description": "Material symbol name; empty when the group has none.",
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "label",
        "icon"
      ]
    }
  }
}
