{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilitiesState",
  "description": "The `capabilities` topic: the flags the Settings registry's `visibleWhen`/`enabledWhen`\nreference. A flag that is absent is false.",
  "type": "object",
  "properties": {
    "health": {
      "$ref": "#/$defs/Health"
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "required": [
    "health",
    "flags"
  ],
  "$defs": {
    "Health": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "stale": {
          "description": "Retained last-good data may be displayed but is visibly stale.",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "available",
        "stale"
      ]
    },
    "Failure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retry": {
          "type": "boolean"
        },
        "dispatched": {
          "description": "False only when the daemon proves no UI provider received the call.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "retry"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported_version",
        "too_large",
        "permission_denied",
        "unknown_topic",
        "unknown_method",
        "unavailable",
        "busy",
        "timeout",
        "stale_revision",
        "validation",
        "io",
        "internal"
      ]
    }
  }
}
