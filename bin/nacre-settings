#!/usr/bin/env python3
"""Open or focus Nacre Settings, optionally at a specific page."""

import argparse
import importlib
import os
from pathlib import Path
import subprocess
import sys
import time
import re


# The active launcher selects the source-installed Bead snapshot; package and
# checkout paths remain fallbacks when no managed Bead shell is active.
def active_launcher(home=None, *, environ=None):
    tools = next(
        (
            parent / "tools"
            for parent in Path(__file__).resolve().parents
            if (parent / "tools/ui_shell_switch.py").is_file()
        ),
        None,
    )
    if tools is None:
        return None
    if str(tools) not in sys.path:
        sys.path.insert(0, str(tools))
    import ui_shell_switch

    home = Path(home or Path.home())
    state_home = Path(
        (environ or os.environ).get("XDG_STATE_HOME", home / ".local/state")
    )
    return ui_shell_switch.UiShell(
        home, state_home / "nacre", environ=environ
    ).active_launcher()


def navigation(home=None, *, launcher_resolver=active_launcher):
    candidates = []
    try:
        launcher = launcher_resolver(home)
        if launcher:
            candidates.append(
                Path(launcher).resolve().parent
                / "shell/settings/registry/navigation.json"
            )
    except (OSError, RuntimeError, subprocess.SubprocessError):
        pass
    candidates.extend(
        [
            Path(__file__).resolve().parents[1]
            / "shell/settings/registry/navigation.json",
            Path("/usr/lib/nacre/ui-shell/shell/settings/registry/navigation.json"),
        ]
    )
    for path in candidates:
        if path.is_file():
            import json

            return json.loads(path.read_text())
    raise RuntimeError("The Settings registry is not installed")


def valid_route(route, home=None, *, launcher_resolver=active_launcher):
    if not route:
        return True
    if len(route) > 256 or not re.fullmatch(
        r"[a-z0-9/-]+(?:#[a-zA-Z0-9._/-]+)?", route
    ):
        return False
    registry = navigation(home, launcher_resolver=launcher_resolver)
    page = route.split("#", 1)[0]
    return page in registry.get("aliases", {}) or any(
        row["id"] == page for row in registry["pages"]
    )


def compositor():
    for directory in (
        Path(__file__).resolve().parents[1] / "nacre/shell-tools",
        Path.home() / ".local/share/nacre/shell/tools",
    ):
        if (directory / "compositor.py").is_file():
            if str(directory) not in sys.path:
                sys.path.insert(0, str(directory))
            return importlib.import_module("compositor")
    raise RuntimeError("The Nacre compositor service is not installed")


def open_settings(page="", runner=subprocess.run, sleep=time.sleep):
    # N0048: provider-neutral route; the daemon forwards it to the registered UI provider.
    command = ["nacrectl", "ui", "nacre", "settings", *([page] if page else [])]
    result = runner(command, capture_output=True, text=True, timeout=3)
    if result.returncode == 0:
        return
    started = runner(
        ["systemctl", "--user", "start", "--no-block", "nacre-shell.service"],
        capture_output=True,
        text=True,
        timeout=3,
    )
    if started.returncode:
        raise RuntimeError("Could not start the desktop service for Settings.")
    for _ in range(32):
        sleep(0.25)
        result = runner(command, capture_output=True, text=True, timeout=2)
        if result.returncode == 0:
            return
    raise RuntimeError(
        "Settings could not connect to the desktop. Check nacre-shell.service."
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "page", nargs="?", default="", metavar="page[/subpage][#setting]"
    )
    args = parser.parse_args()
    try:
        if not valid_route(args.page):
            parser.error("Unknown Settings route: " + args.page)
        open_settings(args.page)
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        message = str(error)
        print("nacre-settings: " + message, file=sys.stderr)
        try:
            compositor().notify("3", 6000, "0", "Nacre Settings: " + message, timeout=2)
        except (OSError, RuntimeError, subprocess.SubprocessError):
            pass
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
