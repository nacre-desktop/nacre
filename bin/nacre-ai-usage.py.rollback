#!/usr/bin/env python3
"""Read provider-supported quota data; capture Claude's native status-line data."""

import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import json
import math
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


def number(value):
    return (
        isinstance(value, (int, float))
        and not isinstance(value, bool)
        and math.isfinite(value)
    )


def snapshot(data):
    result = {}
    for key in ("five_hour", "seven_day"):
        window = data.get("rate_limits", {}).get(key)
        if isinstance(window, dict):
            result[key] = {
                k: v
                for k, v in window.items()
                if k in ("used_percentage", "resets_at") and number(v)
            }
    cost = data.get("cost", {})
    result["session"] = {
        k: v
        for k, v in cost.items()
        if k in ("total_cost_usd", "total_duration_ms") and number(v)
    }
    result["observed_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
    return result


def cache(account):
    if account and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,47}", account):
        raise ValueError("Invalid account")
    return (
        Path.home()
        / ".local/state/nacre/ai/usage"
        / ("claude-" + (account or "default") + ".json")
    )


def reset(value):
    try:
        return dt.datetime.fromtimestamp(value).astimezone().strftime("%a %H:%M")
    except (ValueError, TypeError, OSError):
        return "unknown"


def read(agent, account):
    cache(account)  # Validate before constructing any profile path.
    rows = [
        ("Codex" if agent == "codex" else "Claude Code")
        + " · "
        + (account or "Default")
    ]
    if agent == "claude":
        try:
            data = json.loads(cache(account).read_text())
        except (OSError, ValueError):
            return {
                "rows": rows + ["Not yet reported — available after a Claude response"]
            }
        for key, label in (("five_hour", "5 hour"), ("seven_day", "7 day")):
            w = data.get(key, {})
            if number(w.get("used_percentage")):
                rows.append(
                    f"{label}: {w['used_percentage']:g}% used · resets {reset(w.get('resets_at'))}"
                )
        if len(rows) == 1:
            rows.append("Quota not exposed by this Claude session/account")
        if number(data.get("session", {}).get("total_cost_usd")):
            rows.append(
                f"Session estimate: ${data['session']['total_cost_usd']:.2f} (not subscription billing)"
            )
        rows.append(
            "Cached report: " + data.get("observed_at", "unknown")[:19] + " UTC"
        )
        return {"rows": rows}
    loader = importlib.machinery.SourceFileLoader(
        "usage_chat", str(Path(__file__).resolve().with_name("nacre-ai-chat"))
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    env = dict(
        os.environ,
        CODEX_HOME=str(
            Path.home() / ".local/share/nacre/ai/accounts" / account
            if account
            else Path.home() / ".codex"
        ),
    )
    try:
        with mod.Codex(env) as backend:
            backend.deadline = __import__("time").monotonic() + 8
            data = backend.call("account/rateLimits/read", {})
            buckets = data.get("rateLimitsByLimitId") or {
                "codex": data.get("rateLimits")
            }
            for ident, bucket in buckets.items():
                if not isinstance(bucket, dict):
                    continue
                for key in ("primary", "secondary"):
                    window = bucket.get(key)
                    if isinstance(window, dict) and number(window.get("usedPercent")):
                        mins = window.get("windowDurationMins")
                        duration = f"{mins / 60:g}h" if number(mins) else key
                        rows.append(
                            f"{ident} · {duration}: {window['usedPercent']:g}% used · resets {reset(window.get('resetsAt'))}"
                        )
            if len(rows) == 1:
                rows.append("Quota unavailable for this account/authentication mode")
            try:
                summary = backend.call("account/usage/read", {}).get("summary", {})
                if number(summary.get("lifetimeTokens")):
                    rows.append(
                        f"Reported lifetime tokens: {summary['lifetimeTokens']:,}"
                    )
            except (ValueError, OSError):
                pass  # Older installed clients need not expose activity.
    except (ValueError, OSError, subprocess.SubprocessError):
        rows.append("Usage unavailable — check login or try Refresh")
    return {"rows": rows}


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("command", choices=["read", "capture"])
    p.add_argument("--agent", choices=["codex", "claude"], default="codex")
    p.add_argument("--account", default="")
    p.add_argument("--delegate", default="")
    a = p.parse_args()
    if a.command == "read":
        print(json.dumps(read(a.agent, a.account)))
        return
    raw = sys.stdin.read(1048576)
    data = json.loads(raw)
    result = snapshot(data)
    path = cache(a.account)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as out:
        json.dump(result, out)
        pending = Path(out.name)
    pending.chmod(0o600)
    pending.replace(path)
    if a.delegate:
        # A pre-existing user-configured status line receives its original input.
        subprocess.run(a.delegate, shell=True, input=raw, text=True, timeout=5)
    else:
        windows = [
            f"{key.replace('_', ' ')} {w['used_percentage']:g}%"
            for key, w in result.items()
            if isinstance(w, dict) and number(w.get("used_percentage"))
        ]
        print("Nacre · " + (" · ".join(windows) or "Claude"))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError):
        if "capture" not in sys.argv:
            print(json.dumps({"rows": ["Usage unavailable"]}))
