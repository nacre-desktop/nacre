#!/usr/bin/env python3
"""Give a new Claude session a stable title without replacing a user's rename."""

import json
import re
import sys
import unicodedata
from pathlib import Path

MAX_TRANSCRIPT = 2 * 1024 * 1024
MAX_EVENT = 64 * 1024
MAX_RECORDS = 4096


def clean(value):
    if not isinstance(value, str):
        return ""
    if re.search(
        r"<\s*(?:local-command-stdout|local-command|command-name|command-args|"
        r"task-notification|system-reminder|tool-result|tool_use|tool-use)\b",
        value,
        re.I,
    ):
        return ""
    value = "".join(
        " " if char.isspace() else char
        for char in value
        if not unicodedata.category(char).startswith("C")
    )
    value = re.sub(r"<[^>]{1,200}>", " ", value)
    value = " ".join(value.split()).strip(" \t\r\n-:;,.")
    if not value or re.search(
        r"\b(?:system-reminder|local-command|command-name|task-notification)\b",
        value,
        re.I,
    ):
        return ""
    if value.startswith(("/", "<")):
        return ""
    return value[:80].rstrip()


def candidates(data):
    result = []
    if isinstance(data, dict):
        if data.get("isMeta") or data.get("toolResult"):
            return result
        record_type = data.get("type")
        if record_type == "custom-title":
            result.append(("custom", data.get("customTitle")))
        elif record_type == "ai-title":
            result.append(("ai", data.get("aiTitle")))
        elif record_type == "summary":
            result.append(("summary", data.get("summary")))
    return result


def main():
    try:
        raw_event = sys.stdin.buffer.read(MAX_EVENT + 1)
        if len(raw_event) > MAX_EVENT:
            return
        event = json.loads(raw_event)
        if event.get("isMeta") or event.get("toolResult"):
            return
        transcript = Path(event.get("transcript_path", ""))
        if not transcript.is_file():
            return
        # If this transcript is too large to inspect safely in the hook budget,
        # fail open rather than risk overwriting an old /rename record.
        if transcript.stat().st_size > MAX_TRANSCRIPT:
            return
        with transcript.open("rb") as stream:
            raw_transcript = stream.read(MAX_TRANSCRIPT + 1)
        if len(raw_transcript) > MAX_TRANSCRIPT:
            return
        if raw_transcript.count(b"\n") > MAX_RECORDS:
            return
        text = raw_transcript.decode(errors="replace")
        rows = []
        for line in text.splitlines():
            if not line.strip():
                continue
            try:
                rows.extend(candidates(json.loads(line)))
            except (ValueError, TypeError):
                return
        if any(
            kind == "custom" and isinstance(value, str) and value.strip()
            for kind, value in rows
        ):
            return
        ai_title = next(
            (
                clean(value)
                for kind, value in reversed(rows)
                if kind == "ai" and clean(value)
            ),
            "",
        )
        summary = next(
            (
                clean(value)
                for kind, value in reversed(rows)
                if kind == "summary" and clean(value)
            ),
            "",
        )
        title = ai_title or summary
        if title:
            print(
                json.dumps(
                    {
                        "hookSpecificOutput": {
                            "hookEventName": "UserPromptSubmit",
                            "sessionTitle": title,
                        }
                    }
                )
            )
    except Exception:  # noqa: BLE001 - a title hook must fail open on every error
        return


if __name__ == "__main__":
    main()
