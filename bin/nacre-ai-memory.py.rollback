#!/usr/bin/env python3
"""Store concise evidence and create discoverable, cross-project brain entities."""

import argparse
import datetime as dt
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import nacre_state as _state
import os
import re
import subprocess
import sys
from pathlib import Path


def slug(value):
    return re.sub(r"[^a-z0-9]+", "-", value.casefold()).strip("-")[:70]


def one(value):
    return " ".join(str(value).split())[:180]


def helper(name):
    local = Path(__file__).resolve().with_name(name)
    return str(local if local.exists() else Path.home() / ".local/bin" / name)


def remember(args, body):
    root = Path(
        os.environ.get("NACRE_BRAIN", str(Path.home() / "Documents/Nacre-Brain"))
    )
    # Retain the complete raw-metadata check until the N0021 memory port.
    validation = helper("nacre-brain.py.rollback")
    if not Path(validation).exists():
        validation = helper("nacre-brain")
    loader = importlib.machinery.SourceFileLoader("memory_brain", validation)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    brain = importlib.util.module_from_spec(spec)
    loader.exec_module(brain)
    brain.safe_note(
        "\n".join([args.title, args.source, body, *args.world, *args.topic])
    )
    if not body.strip():
        raise ValueError("Memory is empty")
    worlds = list(dict.fromkeys(one(w) for w in args.world if slug(w)))
    topics = list(
        dict.fromkeys(one(t).replace(",", " ") for t in args.topic if slug(t))
    )
    metadata = "Worlds: " + ", ".join(worlds) + "\nTopics: " + ", ".join(topics) + "\n"
    # Identical milestone captures remain idempotent across concurrent assistants.
    signature = hashlib.sha256(
        json.dumps(
            [
                args.kind,
                one(args.title),
                one(args.source),
                args.confidence,
                worlds,
                topics,
                body.strip(),
            ],
            ensure_ascii=False,
        ).encode()
    ).hexdigest()
    state = root / ".brain-state"
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (state / "capture.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        record = state / ("capture-" + signature + ".json")
        if record.exists():
            note = Path(_state.read_json_file(record)["path"])
        else:
            result = subprocess.run(
                [
                    helper("nacre-brain"),
                    "note",
                    "--kind",
                    args.kind,
                    "--title",
                    one(args.title),
                    "--source",
                    one(args.source),
                    "--confidence",
                    args.confidence,
                ],
                input=metadata + "\n" + body,
                text=True,
                capture_output=True,
                check=True,
            )
            note = Path(result.stdout.strip())
            _state.write(record, {"path": str(note)})
            record.chmod(0o600)
        # Create only missing descriptors. Current curated pages are never overwritten.
        for world in worlds:
            ident = slug(world)
            wiki = root / "wiki" / ("entity-" + ident + ".md")
            existing = None
            for page in (root / "wiki").glob("*.md"):
                text = page.read_text()
                match = re.search(r"(?mi)^Name:\s*(.+)$", text)
                other = re.search(r"(?mi)^Aliases:\s*(.+)$", text)
                names = [
                    page.stem,
                    match.group(1) if match else "",
                    *(other.group(1).split(",") if other else []),
                ]
                if any(slug(n.strip()) == ident for n in names):
                    existing = page
                    break
            if existing:
                continue
            if wiki.exists():
                continue
            content = f"# {world}\n\nEntity: world\nName: {world}\nAliases: {ident}\nReviewed: {dt.date.today()}\nStatus: Evidence-backed subject; initial descriptor\nSource: [[{note.relative_to(root).with_suffix('').as_posix()}]]\n\nThis subject was recorded from conversation or work. It does not imply a registered repository.\n\n## Evidence\n\n- [[{note.relative_to(root).with_suffix('').as_posix()}]]\n"
            result = subprocess.run(
                [
                    helper("nacre-brain-maintain"),
                    "update",
                    str(wiki.relative_to(root)),
                    "--expected-sha256",
                    "new",
                ],
                input=content,
                text=True,
                capture_output=True,
            )
            if result.returncode:
                raise ValueError(
                    "Evidence saved; entity page creation failed. Retry capture to repair."
                )
    return {"path": str(note), "worlds": worlds, "topics": topics}


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--title", required=True)
    p.add_argument("--source", required=True)
    p.add_argument(
        "--kind",
        default="inbox",
        choices=[
            "inbox",
            "personal",
            "projects",
            "infrastructure",
            "devices",
            "runbooks",
            "decisions",
            "checkpoints",
        ],
    )
    p.add_argument(
        "--confidence",
        choices=["verified", "reported", "unverified"],
        default="reported",
    )
    p.add_argument("--world", action="append", default=[])
    p.add_argument("--topic", action="append", default=[])
    a = p.parse_args()
    print(json.dumps(remember(a, sys.stdin.read())))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
