#!/usr/bin/env python3
"""Store concise evidence and create discoverable, cross-project brain entities."""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path


def slug(value):
    return re.sub(r"[^a-z0-9]+", "-", str(value).casefold()).strip("-")[:70]


def one(value):
    return " ".join(str(value).split())[:180]


def remember(args, body):
    if not body.strip():
        raise ValueError("Memory is empty")
    binary = os.environ.get("NACRE_HELPER_BINARY") or str(
        Path.home() / ".local/share/nacre/shell/tools/nacre-helper"
    )
    command = [
        binary,
        "nacre-ai-memory",
        "--title",
        args.title,
        "--source",
        args.source,
        "--kind",
        args.kind,
        "--confidence",
        args.confidence,
    ]
    for flag, values in (
        ("--world", args.world),
        ("--area", getattr(args, "area", [])),
        ("--topic", args.topic),
    ):
        for value in values:
            command.extend((flag, value))
    result = subprocess.run(
        command, input=body, text=True, capture_output=True, check=True
    )
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ValueError("Native memory helper returned invalid JSON") from error
    if not isinstance(payload, dict) or "path" not in payload:
        raise ValueError("Native memory helper returned an invalid result")
    return payload


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--title", required=True)
    p.add_argument("--source", required=True)
    p.add_argument(
        "--kind",
        default="inbox",
        choices=[
            "inbox",
            "personal",
            "projects",
            "infrastructure",
            "devices",
            "runbooks",
            "decisions",
            "checkpoints",
        ],
    )
    p.add_argument(
        "--confidence",
        choices=["verified", "reported", "unverified"],
        default="reported",
    )
    p.add_argument("--world", action="append", default=[])
    p.add_argument("--area", action="append", default=[])
    p.add_argument("--topic", action="append", default=[])
    a = p.parse_args()
    print(json.dumps(remember(a, sys.stdin.read())))


if __name__ == "__main__":
    helper = os.environ.get("NACRE_HELPER_BINARY") or str(
        Path.home() / ".local/share/nacre/shell/tools/nacre-helper"
    )
    os.execv(helper, [helper, "nacre-ai-memory", *sys.argv[1:]])
