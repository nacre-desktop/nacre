#!/usr/bin/env python3
"""Run a document or extraction command in the private skill-tool environment."""

import os
from pathlib import Path
import sys

root = Path.home() / ".local/share/nacre/ai/skill-tools"
if len(sys.argv) < 2:
    raise SystemExit("Usage: nacre-ai-tools python|node|defuddle [arguments...]")
env = dict(os.environ)
env["PATH"] = os.pathsep.join(
    [
        str(root / "python/bin"),
        str(root / "node/bin"),
        str(root / "node_modules/.bin"),
        env.get("PATH", ""),
    ]
)
env["NODE_PATH"] = str(root / "node_modules")
os.execvpe(sys.argv[1], sys.argv[1:], env)
