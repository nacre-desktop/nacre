#!/usr/bin/env python3
"""Resolve conversation context without selecting or executing a project."""

import argparse
import json
import os
import re
from pathlib import Path


def resolve(query):
    path = Path(
        os.environ.get(
            "NACRE_AI_PROJECTS",
            str(Path.home() / ".config/nacre/ai/projects.json"),
        )
    )
    registry = json.loads(path.read_text()) if path.exists() else {}
    words = query.casefold()
    candidates = []
    for project in registry.get("projects", []):
        aliases = [
            project["id"],
            project.get("label", ""),
            *project.get("aliases", []),
            *project.get("brain", {}).get("aliases", []),
        ]
        matches = [
            a
            for a in aliases
            if a and re.search(r"(?<!\w)" + re.escape(a.casefold()) + r"(?!\w)", words)
        ]
        candidates.append(
            {
                k: project[k]
                for k in (
                    "id",
                    "label",
                    "path",
                    "host",
                    "build_host",
                    "build_path",
                    "task_sources",
                )
                if k in project
            }
            | {"matches": matches}
        )
    matched = [p for p in candidates if p["matches"]]
    return {
        "matched": matched,
        "projects": candidates,
        "ambiguous": len(matched) > 1,
        "instruction": "Read repository instructions before editing. Use isolated local worktrees; heavy builds use build_host/build_path and exact changes in isolated remote tmux worktrees. No match is not permission to invent a repository. Multiple matches may be legitimate cross-project work; clarify only if target is unclear.",
    }


if __name__ == "__main__":
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("query", nargs="*")
    args = p.parse_args()
    print(json.dumps(resolve(" ".join(args.query)), indent=2))
