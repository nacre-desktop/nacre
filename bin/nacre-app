#!/usr/bin/env python3
"""Small desktop application routes; executable arguments are never shell strings."""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULTS = {
    "terminal": ["kitty"],
    "browser": ["google-chrome-stable"],
    "files": ["nacre-shell", "dolphin"],
    "mail": ["google-chrome-stable", "--app=https://mail.google.com/"],
    "emoji": ["nacre-menu", "actions.emoji"],
}


def restricted_niri_session():
    """Only bridge desktop terminals affected by Niri's staged user namespace."""
    if os.environ.get("NACRE_COMPOSITOR") != "niri":
        return False
    try:
        mappings = Path("/proc/self/uid_map").read_text().splitlines()
        if mappings and not any(int(row.split()[1]) == 0 for row in mappings):
            return True
        return any(
            line.split() == ["NoNewPrivs:", "1"]
            for line in Path("/proc/self/status").read_text().splitlines()
        )
    except (OSError, ValueError, IndexError):
        return False


def host_terminal(argv):
    """Launch through the normal user manager, outside the compositor overlay."""
    runner = shutil.which("systemd-run")
    if not runner:
        raise SystemExit("Cannot open a normal terminal: systemd-run is unavailable")
    command = [
        runner,
        "--user",
        "--quiet",
        "--wait",
        "--collect",
        "--expand-environment=no",
        "--property=Type=exec",
        "--working-directory=" + str(Path.cwd()),
    ]
    for name in (
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS",
        "XAUTHORITY",
        "NIRI_SOCKET",
        "XDG_CURRENT_DESKTOP",
        "XDG_SESSION_TYPE",
        "NACRE_COMPOSITOR",
        "LANG",
        "LC_ALL",
        "LC_CTYPE",
        "SSH_AUTH_SOCK",
    ):
        if name in os.environ:
            command.append("--setenv=" + name + "=" + os.environ[name])
    # Resolve the terminal in the host manager's PATH, not the overlay's bin tree.
    command += ["--", "/usr/bin/env", "--", *argv]
    try:
        result = subprocess.run(command)
    except OSError as error:
        raise SystemExit(f"Cannot open a normal terminal: {error}") from error
    if result.returncode:
        raise SystemExit(
            "Cannot open a normal terminal through the user manager "
            f"(exit {result.returncode})"
        )


def main():
    name = sys.argv[1] if len(sys.argv) > 1 else "browser"
    config = Path.home() / ".config/nacre/apps.json"
    choices = json.loads(config.read_text()) if config.exists() else {}
    argv = choices.get(name, DEFAULTS.get(name))
    if name == "terminal" and name not in choices:
        config = Path.home() / ".config/nacre/terminal/kitty.conf"
        if config.is_file():
            argv = ["kitty", "--config", str(config)]
    if (
        not isinstance(argv, list)
        or not argv
        or any(not isinstance(a, str) for a in argv)
    ):
        raise SystemExit("Unknown or invalid app route")
    if name == "mail" and name not in choices and shutil.which("evolution"):
        argv = ["evolution"]
    if name == "files" and name not in choices:
        argv = [str(Path.home() / ".local/bin/nacre-shell"), "dolphin"]
    if not shutil.which(argv[0]):
        raise SystemExit(
            "Install the selected application or edit ~/.config/nacre/apps.json"
        )
    argv = [*argv, *sys.argv[2:]]
    if name == "terminal" and restricted_niri_session():
        host_terminal(argv)
        return
    os.execvp(argv[0], argv)


if __name__ == "__main__":
    main()
