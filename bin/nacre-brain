#!/usr/bin/env python3
"""Small, account-independent Markdown knowledge vault and credential references."""

import argparse
import datetime as dt
import getpass
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import uuid


def vault_path():
    override = os.environ.get("NACRE_BRAIN")
    if override:
        return Path(override).expanduser().resolve()
    return (Path.home() / "Documents/Nacre-Brain").resolve()


def initialize():
    root = vault_path()
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    root.chmod(0o700)
    for name in (
        "inbox",
        "personal",
        "projects",
        "infrastructure",
        "devices",
        "runbooks",
        "decisions",
        "credentials",
        "wiki",
        "raw",
        "checkpoints",
    ):
        (root / name).mkdir(exist_ok=True, mode=0o700)
    readme = root / "README.md"
    if not readme.exists():
        readme.write_text("""# Nacre Brain

This private local folder is the durable knowledge bank shared by your Codex and Claude accounts.
Open this folder as an Obsidian vault, or use `nacre-brain search WORDS`.

| Folder | Content |
| --- | --- |
| inbox | New facts and task handoffs awaiting organization |
| personal | Personal preferences and context |
| projects | Project summaries and pointers to canonical repository instructions |
| infrastructure | Dated host inventory, access methods, environment boundaries |
| devices | Device identity, last verified address, hardware evidence |
| runbooks | Repeatable operational procedures |
| decisions | Reasons behind durable choices |
| credentials | Secret-store references only; never secret values |

Search before adding a note. Record a source and verification date; distinguish
observed facts from user reports and unverified historical assumptions. Recheck
host identity before acting on a saved address. Keep project rules in the project.

Notes belong to your OS user, not your ChatGPT account. They are not automatically
available to ordinary ChatGPT web chats. Codex reads them through your global
instructions and personal skills. The public OS repository contains only the
tools and templates, never this folder or Codex account state.

Use `nacre-brain note --help` to save a unique note without concurrent writers
overwriting one another. Use `nacre-brain store-credential NAME` to put a secret
in the OS keyring, then document only its reference. Keyring secrets are not
automatically copied to other hosts. This folder is not a backup by itself.
""")
        readme.chmod(0o600)
    return root


def safe_note(body):
    patterns = (
        r"-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----",
        r"\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{20,}",
        r"\bgh[pousr]_[A-Za-z0-9]{20,}",
        r"(?im)^\s*(?:password|passwd|api[_ -]?key|access[_ -]?token|refresh[_ -]?token)\s*[:=]\s*\S+",
    )
    if any(re.search(pattern, body) for pattern in patterns):
        raise ValueError(
            "Possible credential found. Store the secret in the OS keyring and save only its reference."
        )


def main():
    if len(sys.argv) == 1 or sys.argv[1] in ("open", "brain", "capture"):
        action = sys.argv[1] if len(sys.argv) > 1 else "brain"
        os.execv(
            str(Path.home() / ".local/bin/nacre-brain-ui"),
            ["nacre-brain-ui", "brain" if action == "open" else action],
        )
    parser = argparse.ArgumentParser(prog="nacre-brain", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("init")
    sub.add_parser("path")
    search = sub.add_parser("search")
    search.add_argument("query", nargs="+")
    note = sub.add_parser(
        "note", help="Read a Markdown note from stdin; write a unique dated file"
    )
    note.add_argument(
        "--kind",
        choices=[
            "inbox",
            "personal",
            "projects",
            "infrastructure",
            "devices",
            "runbooks",
            "decisions",
            "credentials",
            "checkpoints",
        ],
        default="inbox",
    )
    note.add_argument("--title", required=True)
    note.add_argument("--source", required=True)
    note.add_argument(
        "--confidence",
        choices=["verified", "reported", "unverified"],
        default="reported",
    )
    secret = sub.add_parser(
        "store-credential",
        help="Prompt privately and store a credential in the OS keyring",
    )
    secret.add_argument("name")
    run = sub.add_parser(
        "run-with-credential",
        help="Supply a keyring secret directly to a child environment",
    )
    run.add_argument("name")
    run.add_argument("--env", required=True)
    run.add_argument("program", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.command == "path":
        print(vault_path())
        return
    root = initialize()
    if args.command == "init":
        print(root)
    elif args.command == "search":
        raise SystemExit(
            subprocess.call(
                [
                    "rg",
                    "-n",
                    "-i",
                    "-F",
                    "--glob",
                    "*.md",
                    "--",
                    " ".join(args.query),
                    str(root),
                ]
            )
        )
    elif args.command == "note":
        body = sys.stdin.read()
        safe_note("\n".join((args.title, args.source, body)))
        if not body.strip():
            raise ValueError("Note is empty")
        now = dt.datetime.now(dt.timezone.utc)
        slug = re.sub(r"[^a-z0-9]+", "-", args.title.lower()).strip("-")[:70] or "note"
        path = (
            root / args.kind / f"{now:%Y%m%dT%H%M%SZ}-{slug}-{uuid.uuid4().hex[:8]}.md"
        )
        # Plain Markdown metadata avoids treating arbitrary user strings as YAML.
        text = f"# {args.title.replace(chr(10), ' ')}\n\nRecorded: {now.isoformat()}\nConfidence: {args.confidence}\nSource: {args.source.replace(chr(10), ' ')}\n\n{body.rstrip()}\n"
        with tempfile.NamedTemporaryFile(
            mode="w", dir=path.parent, prefix=".note-", delete=False
        ) as out:
            pending = Path(out.name)
            out.write(text)
        try:
            os.link(pending, path)
        finally:
            pending.unlink()
        print(path)
    elif args.command == "store-credential":
        value = getpass.getpass(f"Secret for {args.name}: ")
        if not value:
            raise ValueError("Secret is empty")
        subprocess.run(
            [
                "secret-tool",
                "store",
                "--label",
                f"Nacre Brain: {args.name}",
                "service",
                "nacre-brain",
                "name",
                args.name,
            ],
            input=value,
            text=True,
            check=True,
        )
        print(f"Saved reference: secret-service://nacre-brain/{args.name}")
    elif args.command == "run-with-credential":
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", args.env):
            raise ValueError("Invalid environment variable name")
        program = args.program[1:] if args.program[:1] == ["--"] else args.program
        if not program:
            raise ValueError("Supply a command after --")
        value = ""
        for service in ("nacre-brain",):
            result = subprocess.run(
                ["secret-tool", "lookup", "service", service, "name", args.name],
                capture_output=True,
                text=True,
            )
            if result.returncode == 0 and result.stdout.rstrip("\n"):
                value = result.stdout.rstrip("\n")
                break
        if not value:
            raise ValueError("Credential not found or keyring is locked")
        env = dict(os.environ)
        env[args.env] = value
        os.execvpe(program[0], program, env)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"nacre-brain: {error}", file=sys.stderr)
        raise SystemExit(1) from None
