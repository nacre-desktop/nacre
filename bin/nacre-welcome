#!/usr/bin/env python3
"""Open the single Nacre Welcome window; automatically shown once on first login."""

import argparse
import json
from pathlib import Path
import subprocess
import sys
import time


def helper(action, value="", runner=subprocess.run):
    path = Path.home() / ".local/share/nacre/shell/tools/welcome.py"
    result = runner(
        ["python3", str(path), action, value], capture_output=True, text=True, timeout=4
    )
    try:
        data = json.loads(result.stdout)
    except ValueError as error:
        raise RuntimeError(
            "Welcome preferences could not be read. Check that the Nacre desktop is installed."
        ) from error
    if result.returncode or data.get("error"):
        raise RuntimeError(data.get("error", "Could not read Welcome preferences"))
    return data


def open_welcome(page="home", runner=subprocess.run, sleep=time.sleep):
    command = ["quickshell", "ipc", "-c", "nacre", "call", "welcomeApp", "open", page]
    result = runner(command, capture_output=True, text=True, timeout=3)
    if result.returncode == 0:
        return
    started = runner(
        ["systemctl", "--user", "start", "--no-block", "nacre-shell.service"],
        capture_output=True,
        text=True,
        timeout=3,
    )
    if started.returncode:
        raise RuntimeError("Could not start the desktop service for Welcome")
    for _ in range(40):
        sleep(0.25)
        result = runner(command, capture_output=True, text=True, timeout=2)
        if result.returncode == 0:
            return
    raise RuntimeError("Welcome could not connect. Check nacre-shell.service")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--login", action="store_true")
    mode.add_argument("--enable", action="store_true")
    mode.add_argument("--disable", action="store_true")
    parser.add_argument(
        "page",
        nargs="?",
        default="home",
        choices=("home", "colors", "shortcuts", "apps", "ready", "help"),
    )
    args = parser.parse_args()
    claim = ""
    try:
        if args.enable or args.disable:
            helper("set-startup", json.dumps(args.enable))
            subprocess.run(
                ["quickshell", "ipc", "-c", "nacre", "call", "welcomeApp", "refresh"],
                capture_output=True,
                timeout=2,
            )
            return 0
        if args.login:
            decision = helper("claim-login")
            if not decision["show"]:
                return 0
            claim = decision["claim"]
        open_welcome(args.page)
        if claim:
            helper("acknowledge-login", claim)
        return 0
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        if claim:
            try:
                helper("release-login", claim)
            except (OSError, RuntimeError, ValueError, subprocess.SubprocessError):
                pass
        print("nacre-welcome: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
