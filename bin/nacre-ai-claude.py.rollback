#!/usr/bin/env python3
"""Launch Claude tasks and read native session metadata using Anthropic's SDK."""

import argparse
import importlib
from pathlib import Path
import sys
import json
import os
import re
import shlex
import shutil
import subprocess
import uuid

for _core_directory in (
    Path(__file__).resolve().parents[1] / "nacre/shell-tools",
    Path.home() / ".local/share/nacre/shell/tools",
):
    if (_core_directory / "nacre_ai_core.py").is_file():
        sys.path.insert(0, str(_core_directory))
        break
_core = importlib.import_module("nacre_ai_core")


def agent_full_access():
    return _core.full_access()


def environment(account):
    return _core.environment("claude", account)


def executable():
    binary = shutil.which("claude")
    if not binary:
        raise ValueError(
            "Claude Code is not installed on this host. Install it using https://code.claude.com/docs/en/setup"
        )
    return binary


def sdk():
    try:
        import claude_agent_sdk

        return claude_agent_sdk
    except ImportError as error:
        python = Path.home() / ".local/share/nacre/ai/claude-sdk/bin/python"
        if python.is_file() and Path(sys.prefix) != python.parent.parent:
            os.execv(
                str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]]
            )
        raise ValueError(
            "Install the Claude history dependency: python3 ai/install-claude.py"
        ) from error


def running_sessions(project, account):
    if not shutil.which("tmux"):
        return {}
    tag = "profile-" + account if account else "default"
    prefix = f"ai-{project}-claude-{tag}-"
    try:
        result = subprocess.run(
            ["tmux", "list-panes", "-a", "-F", "#{session_name}\t#{pane_current_path}"],
            text=True,
            capture_output=True,
            timeout=4,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    return {
        name: cwd
        for row in result.stdout.splitlines()
        if "\t" in row
        for name, cwd in [row.split("\t", 1)]
        if name.startswith(prefix)
    }


def session_inventory(directory, chat_directory=False):
    """Return bounded SDK metadata used for safe resume names and legacy matches."""
    api = sdk()
    root = Path(directory)
    if chat_directory and root.is_dir():
        paths = [
            root,
            *[
                child
                for child in root.iterdir()
                if child.is_dir()
                and not child.is_symlink()
                and re.fullmatch(r"[0-9a-f]{32}", child.name)
            ],
        ]
        return [
            session
            for path in paths
            for session in api.list_sessions(
                directory=str(path), limit=500, include_worktrees=False
            )
        ]
    return api.list_sessions(directory=str(root), limit=500, include_worktrees=True)


def resume_metadata(directory, thread_id, chat_directory=False):
    """Read actual current title metadata; missing history must never imply no rename."""
    try:
        sessions = session_inventory(directory, chat_directory)
        # SDK calls are read-only; de-duplicate in case overlapping path queries
        # return the same transcript more than once.
        unique = {session.session_id: session for session in sessions}
        sessions = list(unique.values())
        return sessions, next(
            (session for session in sessions if session.session_id == thread_id), None
        )
    except (
        OSError,
        ValueError,
        TypeError,
        AttributeError,
        ImportError,
        RuntimeError,
        subprocess.SubprocessError,
    ):
        return None, None


def tmux_options(session):
    """Keep Claude's viewport and wheel usable without altering tmux defaults."""
    return [
        ";",
        "set-option",
        "-t",
        session,
        "status",
        "off",
        ";",
        "set-option",
        "-t",
        session,
        "mouse",
        "on",
    ]


def session_key(value):
    return re.sub(r"[^0-9a-f]", "", str(value).lower())


def records(sessions, running, fallback):
    output = []
    seen = set()
    matched = set()
    by_id = {
        session_key(match.group(1)): name
        for name in running
        if (
            match := re.search(
                r"([0-9a-f]{32}|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$", name
            )
        )
    }
    remaining = []
    for session in sessions:
        if session.session_id in seen:
            continue
        seen.add(session.session_id)
        cwd = session.cwd or fallback
        tmux = by_id.get(session_key(session.session_id))
        if tmux:
            matched.add(tmux)
        else:
            remaining.append((session, cwd))
        output.append(
            {
                "id": session.session_id,
                "title": session.custom_title
                or session.summary
                or session.first_prompt
                or "New chat",
                "updated_at": session.last_modified / 1000,
                "cwd": cwd,
                "state": "running" if tmux else "saved",
                "session": tmux,
                "agent": "claude",
            }
        )
    # Legacy tmux names have no session ID. Use cwd only when the relationship
    # is one-to-one, so a shared general-chat root never mislabels old chats.
    cwd_counts = {}
    for _, cwd in remaining:
        cwd_counts[cwd] = cwd_counts.get(cwd, 0) + 1
    for cwd, count in cwd_counts.items():
        candidates = [
            name
            for name, path in running.items()
            if path == cwd and name not in matched
        ]
        if count == 1 and len(candidates) == 1:
            name = candidates[0]
            record = next(
                row for row in output if row["cwd"] == cwd and row["state"] == "saved"
            )
            record["session"] = name
            record["state"] = "running"
            matched.add(name)
    return output


def tmux_resume_target(project, account, thread_id, sessions, directory):
    """Find an exact tmux identity or one provably unique legacy cwd match."""
    running = running_sessions(project, account)
    target_key = session_key(thread_id)
    exact = [
        name
        for name in running
        if (
            match := re.search(
                r"([0-9a-f]{32}|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
                name,
            )
        )
        and session_key(match.group(1)) == target_key
    ]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        raise ValueError("Multiple Claude tmux sessions match this chat ID")

    # Old launchers used random suffixes. Attach only when transcript history
    # proves this cwd has exactly one chat and exactly one live legacy session.
    known_keys = {session_key(session.session_id) for session in (sessions or [])}
    legacy = []
    for name in running:
        match = re.search(
            r"([0-9a-f]{32}|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
            name,
        )
        if not match or session_key(match.group(1)) not in known_keys:
            legacy.append(name)
    cwd = None
    metadata = None
    if sessions is not None:
        metadata = next(
            (session for session in sessions if session.session_id == thread_id), None
        )
        cwd = str(metadata.cwd) if metadata and metadata.cwd else None
    cwd = cwd or str(Path(directory))
    cwd_history = [
        session
        for session in (sessions or [])
        if str(Path(session.cwd or directory).resolve()) == str(Path(cwd).resolve())
    ]
    if metadata is None:
        root = Path(directory).resolve()
        cwd_legacy = [
            name
            for name in legacy
            if Path(running[name]).resolve() == root
            or root in Path(running[name]).resolve().parents
        ]
    else:
        cwd_legacy = [
            name
            for name in legacy
            if str(Path(running[name]).resolve()) == str(Path(cwd).resolve())
        ]
    if cwd_legacy:
        if (
            len(cwd_history) == 1
            and cwd_history[0].session_id == thread_id
            and len(cwd_legacy) == 1
        ):
            return cwd_legacy[0]
        raise ValueError(
            "A legacy Claude tmux session is running in this workspace, but the chat match is ambiguous. "
            "Use Nacre's chat list to attach safely."
        )
    return None


def background_session(binary, env, thread_id):
    """Find the background session holding a chat, e.g. after an exit handoff on logout."""
    try:
        result = subprocess.run(
            [binary, "agents", "--json"],
            env=env,
            text=True,
            capture_output=True,
            timeout=10,
        )
        agents = [
            a
            for a in json.loads(result.stdout)
            if a.get("kind") == "background" and a.get("id")
        ]
    except (OSError, ValueError, TypeError, AttributeError, subprocess.SubprocessError):
        return None
    for agent in agents:
        if agent.get("sessionId") == thread_id:
            return agent["id"]
    # A handoff continues the chat as a fork; the daemon roster names the original transcript.
    try:
        workers = json.loads(
            (Path(env["CLAUDE_CONFIG_DIR"]) / "daemon/roster.json").read_text()
        )["workers"]
        for agent in agents:
            launch = workers.get(agent["id"], {}).get("dispatch", {}).get("launch", {})
            if Path(str(launch.get("sessionId", ""))).stem == thread_id:
                return agent["id"]
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        pass
    return None


def list_chats(args):
    config = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude")))
    if not (config / "projects").is_dir():
        return []
    api = sdk()
    root = Path(args.path)
    if args.chat_directory:
        paths = (
            [
                root,
                *[
                    p
                    for p in root.iterdir()
                    if p.is_dir()
                    and not p.is_symlink()
                    and re.fullmatch(r"[0-9a-f]{32}", p.name)
                ],
            ]
            if root.is_dir()
            else []
        )
        sessions = [
            s
            for path in paths
            for s in api.list_sessions(
                directory=str(path), limit=500, include_worktrees=False
            )
        ]
    else:
        sessions = api.list_sessions(
            directory=str(root), limit=500, include_worktrees=True
        )
    return records(sessions, running_sessions(args.project, args.account), str(root))


def guidance():
    return (
        "This session was opened with Nacre AI. Read ~/.codex/AGENTS.md for shared personal workflow, "
        "and ~/.config/nacre/ai/projects.json for project/build-host locations. "
        "Read the selected project and working directory AGENTS.md as well as CLAUDE.md before editing. "
        "Follow project instructions and use isolated worktrees. Keep this conversation when the user changes project. "
        "Search the private brain with nacre-brain search and automatically save durable findings using "
        "nacre-brain note; read ~/.agents/skills/nacre-brain/SKILL.md for details. "
        "Codex-specific title tools do not apply to Claude: use Claude native session titles and /rename. "
        "Never copy Codex or Claude credentials between accounts. "
        "A General chat folder is for conversation; resolve relevant projects later using nacre-ai-context QUERY. "
        "Save meaningful findings through nacre-ai-memory with --world and --topic, including personal and research topics. "
        "Read ~/.agents/skills/nacre-brain/SKILL.md. Do not store transcripts or turn suggestions into facts."
    )


def prepare_directory(args):
    root = Path(args.path)
    if args.chat_directory:
        directory = root / uuid.uuid4().hex
        directory.mkdir(parents=True, mode=0o700)
        return directory
    task = uuid.uuid4().hex
    directory = Path.home() / ".local/share/nacre/ai/worktrees" / args.project / task
    directory.parent.mkdir(parents=True, exist_ok=True)
    has_head = (
        subprocess.run(
            ["git", "-C", str(root), "rev-parse", "--verify", "HEAD"],
            capture_output=True,
        ).returncode
        == 0
    )
    command = ["git", "-C", str(root), "worktree", "add"]
    if not has_head:
        command.append("--orphan")
    subprocess.run([*command, "-b", "claude/" + task, str(directory)], check=True)
    return directory


def run(args):
    env = environment(args.account)
    subprocess.run(
        [
            str(Path.home() / ".local/bin/nacre-ai-skills"),
            "--claude-home",
            env["CLAUDE_CONFIG_DIR"],
        ],
        check=True,
    )
    os.environ.update(env)
    if args.command == "list":
        print(json.dumps(list_chats(args)))
        return
    binary = executable()  # Fail before creating worktrees when Claude is absent.
    if args.command == "login":
        os.execvpe(binary, [binary, "auth", "login"], env)
    if args.command == "new" and not args.thread_id:
        args.thread_id = str(uuid.uuid4())
    elif args.command == "new":
        uuid.UUID(args.thread_id)
    sessions = None
    resume_session = None
    resume_title = ""
    resume_custom_title = False
    if args.command == "resume":
        if not args.thread_id:
            raise ValueError("A Claude session ID is required")
        uuid.UUID(args.thread_id)
        sessions, metadata = resume_metadata(
            args.path, args.thread_id, getattr(args, "chat_directory", False)
        )
        if metadata is not None:
            resume_custom_title = bool(metadata.custom_title)
            resume_title = (
                metadata.custom_title
                or metadata.summary
                or metadata.first_prompt
                or "New chat"
            )
        if not getattr(args, "tmux_child", False):
            resume_session = tmux_resume_target(
                args.project, args.account, args.thread_id, sessions, args.path
            )
            if resume_session:
                os.execvpe(
                    "tmux",
                    [
                        "tmux",
                        "attach-session",
                        "-t",
                        "=" + resume_session,
                        *tmux_options(resume_session),
                    ],
                    env,
                )
    if args.tmux:
        tag = "profile-" + args.account if args.account else "default"
        session_id = args.thread_id or uuid.uuid4().hex
        session = f"ai-{args.project}-claude-{tag}-{session_id}"
        argv = [
            str(Path(__file__).resolve()),
            args.command,
            "--project",
            args.project,
            "--path",
            args.path,
            "--account",
            args.account,
        ]
        argv += ["--thread-id", session_id]
        if args.chat_directory:
            argv += ["--chat-directory"]
        argv += ["--tmux-child"]
        os.execvpe(
            "tmux",
            [
                "tmux",
                "new-session",
                "-A",
                "-s",
                session,
                shlex.join(argv),
                *tmux_options(session),
            ],
            env,
        )
    directory = Path(args.path) if args.command == "resume" else prepare_directory(args)
    if not directory.is_dir():
        raise ValueError(f"The saved workspace no longer exists: {directory}")
    os.chdir(directory)
    vault = Path(
        os.environ.get("NACRE_BRAIN", str(Path.home() / "Documents/Nacre-Brain"))
    )
    vault.mkdir(parents=True, exist_ok=True, mode=0o700)
    argv = [
        binary,
        *(["--dangerously-skip-permissions"] if agent_full_access() else []),
        "--append-system-prompt",
        guidance(),
        "--add-dir",
        str(vault),
    ]
    if args.command == "new":
        argv += ["--session-id", args.thread_id]
    # Per-session overlay keeps subscription metrics private and preserves a custom status line.
    status = {}
    for settings in (
        Path(env["CLAUDE_CONFIG_DIR"]) / "settings.json",
        directory / ".claude/settings.json",
        directory / ".claude/settings.local.json",
    ):
        if settings.exists():
            status.update(json.loads(settings.read_text()).get("statusLine", {}))
    command = [
        str(Path.home() / ".local/bin/nacre-ai-usage"),
        "capture",
        "--agent",
        "claude",
        "--account",
        args.account,
    ]
    if status.get("command"):
        command += ["--delegate", status["command"]]
    hook = Path(__file__).resolve().with_name("nacre-ai-claude-title-hook")
    overlay = {
        "statusLine": {"type": "command", "command": shlex.join(command)},
        "hooks": {
            "UserPromptSubmit": [
                {
                    "matcher": "",
                    "hooks": [
                        {
                            "type": "command",
                            "command": shlex.join(["python3", str(hook)]),
                        }
                    ],
                }
            ]
        },
    }
    argv += ["--settings", json.dumps(overlay)]
    if args.command == "resume":
        if resume_title and not resume_custom_title:
            argv += ["--name", resume_title]
        attached = background_session(binary, env, args.thread_id)
        if attached:
            os.execvpe(binary, [binary, "attach", attached], env)
        argv += ["--resume", args.thread_id]
    os.execvpe(binary, argv, env)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("command", choices=["new", "resume", "list", "login"])
    p.add_argument("--project", default="general-chat")
    p.add_argument("--path", default=str(Path.home() / ".local/share/nacre/ai/chats"))
    p.add_argument("--account", default="")
    p.add_argument("--thread-id")
    p.add_argument("--chat-directory", action="store_true")
    p.add_argument("--tmux", action="store_true")
    p.add_argument("--tmux-child", action="store_true", help=argparse.SUPPRESS)
    args = p.parse_args()
    if (
        not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", args.project)
        or not Path(args.path).is_absolute()
    ):
        raise ValueError("A valid project ID and absolute path are required")
    run(args)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print(f"nacre-ai-claude: {error}", file=sys.stderr)
        raise SystemExit(1) from None
