// Generated from compositor-contract.json; edit the neutral source.
// Include before user bindings/rules so user-owned choices take precedence.
binds {
    XF86AudioMute repeat=false allow-when-locked=true hotkey-overlay-title="Nacre:mute" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioLowerVolume repeat=true allow-when-locked=true hotkey-overlay-title="Nacre:volume-down" { spawn-sh "key_ms=$(date +%s%3N); nacrectl key-step audio.step \"{\\\"direction\\\":\\\"down\\\",\\\"key_ms\\\":$key_ms}\" || { rc=$?; if [ \"$rc\" -eq 69 ]; then wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; else exit \"$rc\"; fi; }"; }
    XF86AudioRaiseVolume repeat=true allow-when-locked=true hotkey-overlay-title="Nacre:volume-up" { spawn-sh "key_ms=$(date +%s%3N); nacrectl key-step audio.step \"{\\\"direction\\\":\\\"up\\\",\\\"key_ms\\\":$key_ms}\" || { rc=$?; if [ \"$rc\" -eq 69 ]; then wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; else exit \"$rc\"; fi; }"; }
    XF86AudioMicMute repeat=false hotkey-overlay-title="Nacre:mic-mute" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86PowerOff repeat=false allow-when-locked=true hotkey-overlay-title="Nacre:lock" { spawn-sh "loginctl lock-session"; }
    XF86MonBrightnessDown repeat=true hotkey-overlay-title="Nacre:brightness-down" { spawn-sh "key_ms=$(date +%s%3N); nacrectl key-step brightness.adjust \"{\\\"delta\\\":-5,\\\"key_ms\\\":$key_ms}\" || { rc=$?; if [ \"$rc\" -eq 69 ]; then brightnessctl set 5%-; else exit \"$rc\"; fi; }"; }
    XF86MonBrightnessUp repeat=true hotkey-overlay-title="Nacre:brightness-up" { spawn-sh "key_ms=$(date +%s%3N); nacrectl key-step brightness.adjust \"{\\\"delta\\\":5,\\\"key_ms\\\":$key_ms}\" || { rc=$?; if [ \"$rc\" -eq 69 ]; then brightnessctl set 5%+; else exit \"$rc\"; fi; }"; }
    XF86KbdBrightnessUp repeat=true hotkey-overlay-title="Nacre:keyboard-up" { spawn-sh "key_ms=$(date +%s%3N); nacrectl key-step keyboard_light.adjust \"{\\\"step\\\":\\\"up\\\",\\\"key_ms\\\":$key_ms}\" || { rc=$?; if [ \"$rc\" -eq 69 ]; then brightnessctl -d '*kbd_backlight*' set 1+; else exit \"$rc\"; fi; }"; }
    XF86KbdBrightnessDown repeat=true hotkey-overlay-title="Nacre:keyboard-down" { spawn-sh "key_ms=$(date +%s%3N); nacrectl key-step keyboard_light.adjust \"{\\\"step\\\":\\\"down\\\",\\\"key_ms\\\":$key_ms}\" || { rc=$?; if [ \"$rc\" -eq 69 ]; then brightnessctl -d '*kbd_backlight*' set 1-; else exit \"$rc\"; fi; }"; }
    Super+period repeat=false hotkey-overlay-title="Nacre:emoji" { spawn "nacrectl" "ui" "nacre" "menu" "actions.emoji" ""; }
    Super+Ctrl+E repeat=false hotkey-overlay-title="Nacre:emoji" { spawn "nacrectl" "ui" "nacre" "menu" "actions.emoji" ""; }
    Print repeat=false hotkey-overlay-title="Nacre:screenshot" { spawn-sh "g=$(slurp) || exit 0; grim -g \"$g\" - | wl-copy --type image/png && notify-send -a \"Nacre Capture\" -i nacre-notifications \"Screenshot\" \"Copied to clipboard\""; }
    Super+Shift+S repeat=false hotkey-overlay-title="Nacre:screenshot" { spawn-sh "g=$(slurp) || exit 0; grim -g \"$g\" - | wl-copy --type image/png && notify-send -a \"Nacre Capture\" -i nacre-notifications \"Screenshot\" \"Copied to clipboard\""; }
    Super+Print repeat=false hotkey-overlay-title="Nacre:save-screenshot" { spawn-sh "mkdir -p \"$HOME/Pictures/Screenshots\" && niri msg action screenshot-screen --show-pointer false --path \"$HOME/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S_%N).png\""; }
    Super+Q repeat=false hotkey-overlay-title="Nacre:close" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action close_window"; }
    Super+F repeat=false hotkey-overlay-title="Nacre:fullscreen" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action fullscreen_window --mode fullscreen"; }
    Super+M repeat=false hotkey-overlay-title="Nacre:maximize" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action fullscreen_window --mode maximized"; }
    Super+T repeat=false hotkey-overlay-title="Nacre:float" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action float_window --action toggle"; }
    Super+G repeat=false hotkey-overlay-title="Nacre:group" { spawn-sh "niri msg action toggle-column-tabbed-display"; }
    Super+Ctrl+Page_Up repeat=false hotkey-overlay-title="Nacre:group-cycle" { spawn-sh "niri msg action focus-window-up-or-bottom"; }
    Super+Ctrl+Page_Down repeat=false hotkey-overlay-title="Nacre:group-cycle" { spawn-sh "niri msg action focus-window-down-or-top"; }
    Alt+TAB repeat=false hotkey-overlay-title="Nacre:cycle-window" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action cycle_window --direction next"; }
    Alt+Shift+TAB repeat=false hotkey-overlay-title="Nacre:cycle-window" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action cycle_window --direction previous"; }
    Super+1 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 1"; }
    Super+Shift+1 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 1"; }
    Super+2 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 2"; }
    Super+Shift+2 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 2"; }
    Super+3 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 3"; }
    Super+Shift+3 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 3"; }
    Super+4 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 4"; }
    Super+Shift+4 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 4"; }
    Super+5 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 5"; }
    Super+Shift+5 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 5"; }
    Super+6 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 6"; }
    Super+Shift+6 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 6"; }
    Super+7 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 7"; }
    Super+Shift+7 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 7"; }
    Super+8 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 8"; }
    Super+Shift+8 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 8"; }
    Super+9 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 9"; }
    Super+Shift+9 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 9"; }
    Super+0 repeat=false hotkey-overlay-title="Nacre:workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace 10"; }
    Super+Shift+0 repeat=false hotkey-overlay-title="Nacre:move-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace 10"; }
    Super+Ctrl+Right repeat=false hotkey-overlay-title="Nacre:next-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace '{\"relative\": 1}'"; }
    Super+Ctrl+Left repeat=false hotkey-overlay-title="Nacre:previous-workspace" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace '{\"relative\": -1}'"; }
    Super+WheelScrollDown repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace '{\"relative\": 1}'"; }
    Super+WheelScrollUp repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action switch_workspace --workspace '{\"relative\": -1}'"; }
    Super+Ctrl+Shift+Left repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace '{\"relative\": -1}'"; }
    Super+Ctrl+Shift+Right repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_window --workspace '{\"relative\": 1}'"; }
    Super+Left repeat=true cooldown-ms=120 hotkey-overlay-title="Nacre:focus" { focus-column-left; }
    Super+Shift+Left repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_direction --direction left"; }
    Super+Alt+Left repeat=true { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action resize_window --width -30 --height 0 --relative true"; }
    Super+Right repeat=true cooldown-ms=120 hotkey-overlay-title="Nacre:focus" { focus-column-right; }
    Super+Shift+Right repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_direction --direction right"; }
    Super+Alt+Right repeat=true { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action resize_window --width 30 --height 0 --relative true"; }
    Super+Up repeat=false hotkey-overlay-title="Nacre:focus" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action focus_direction --direction up"; }
    Super+Shift+Up repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_direction --direction up"; }
    Super+Alt+Up repeat=true { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action resize_window --width 0 --height -30 --relative true"; }
    Super+Down repeat=false hotkey-overlay-title="Nacre:focus" { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action focus_direction --direction down"; }
    Super+Shift+Down repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action move_direction --direction down"; }
    Super+Alt+Down repeat=true { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action resize_window --width 0 --height 30 --relative true"; }
    Super+SPACE repeat=false hotkey-overlay-title="Nacre:launcher" { spawn "nacrectl" "ui" "nacre" "launcher" ""; }
    Super+TAB repeat=false hotkey-overlay-title="Nacre:overview" { spawn-sh "niri msg action toggle-overview"; }
    Super+V repeat=false hotkey-overlay-title="Nacre:clipboard" { spawn "nacrectl" "ui" "nacre" "clipboard"; }
    Super+W repeat=false hotkey-overlay-title="Nacre:wallpaper" { spawn "nacrectl" "ui" "nacre" "launcher" ">wallpaper "; }
    Super+Shift+W repeat=false hotkey-overlay-title="Nacre:widgets" { spawn-sh "~/.local/bin/nacre-shell --app widgets"; }
    Super+Z repeat=false { spawn "nacrectl" "ui" "nacre" "hide"; }
    Super+O repeat=false { spawn "nacrectl" "ui" "drawers" "toggle" "dashboard"; }
    Super+I repeat=false hotkey-overlay-title="Nacre:settings" { spawn-sh "~/.local/bin/nacre-settings"; }
    Super+Ctrl+C repeat=false { spawn "nacrectl" "ui" "nacre" "menu" "actions.capture" ""; }
    Super+X repeat=false hotkey-overlay-title="Nacre:power" { spawn "nacrectl" "ui" "nacre" "menu" "power" ""; }
    Super+ESCAPE repeat=false hotkey-overlay-title="Nacre:power" { spawn "nacrectl" "ui" "nacre" "menu" "power" ""; }
    Super+L repeat=false hotkey-overlay-title="Nacre:lock" { spawn-sh "loginctl lock-session"; }
    Super+Shift+R repeat=false { spawn-sh "exec env NACRE_COMPOSITOR=niri \"${NACRE_COMPOSITOR_TOOLS:-$HOME/.local/share/nacre/shell/tools}/nacre-helper\" compositor action reload"; }
    Super+RETURN repeat=false hotkey-overlay-title="Nacre:terminal" { spawn-sh "uwsm app -- ~/.local/bin/nacre-app terminal"; }
    Super+Shift+B repeat=false hotkey-overlay-title="Nacre:browser" { spawn-sh "uwsm app -- ~/.local/bin/nacre-app browser"; }
    Super+E repeat=false hotkey-overlay-title="Nacre:files" { spawn-sh "~/.local/bin/nacre-app files"; }
    Super+B repeat=false { spawn-sh "~/.local/bin/nacre-brain open"; }
    Super+N repeat=false { spawn-sh "~/.local/bin/nacre-brain capture"; }
    Super+Ctrl+SPACE repeat=false hotkey-overlay-title="Nacre:palette" { spawn "nacrectl" "ui" "nacre" "mode" "palette"; }
    Super+K repeat=false hotkey-overlay-title="Nacre:shortcuts" { spawn "nacrectl" "ui" "nacre" "menu" "learn.shortcuts" ""; }
    Super+F1 repeat=false hotkey-overlay-title="Nacre:shortcuts" { spawn "nacrectl" "ui" "nacre" "menu" "learn.shortcuts" ""; }
    Super+A repeat=false hotkey-overlay-title="Nacre:ai-sidebar" { spawn "nacrectl" "ui" "nacre" "left"; }
    Super+Ctrl+D repeat=false hotkey-overlay-title="Nacre:detach-panel" { spawn-sh "~/.local/bin/nacre-shell detach"; }
}
