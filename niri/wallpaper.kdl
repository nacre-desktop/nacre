// Keep one full-size wallpaper behind all workspaces, including the overview.
// Include before user settings so local appearance choices can override this.
layer-rule {
    match namespace="^nacre-background$"
    place-within-backdrop true
}

layout {
    background-color "transparent"
}

overview {
    workspace-shadow {
        // A thin edge reveals empty workspaces without shading their interiors.
        on
        softness 0
        spread 2
        offset x=0 y=0
        color "#ffffff40"
    }
}
