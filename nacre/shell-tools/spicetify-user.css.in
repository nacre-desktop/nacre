/* Nacre: map Spotify's Encore design tokens onto the palette so every surface follows it. */
:root,
.encore-dark-theme,
.encore-dark-theme .encore-base-set,
.encore-dark-theme .encore-bright-accent-set,
.encore-dark-theme .encore-inverted-light-set,
.encore-light-theme,
.encore-light-theme .encore-base-set {
  --background-base: #{{surface}} !important;
  --background-highlight: #{{surfaceContainerHigh}} !important;
  --background-press: #{{surfaceContainerLowest}} !important;
  --background-elevated-base: #{{surfaceContainer}} !important;
  --background-elevated-highlight: #{{surfaceContainerHigh}} !important;
  --background-elevated-press: #{{surfaceContainerLow}} !important;
  --background-tinted-base: color-mix(in oklab, #{{onSurface}} 8%, transparent) !important;
  --background-tinted-highlight: color-mix(in oklab, #{{onSurface}} 12%, transparent) !important;
  --background-tinted-press: color-mix(in oklab, #{{onSurface}} 4%, transparent) !important;
  --background-unsafe-for-small-text-base: #{{surface}} !important;
  --text-base: #{{onSurface}} !important;
  --text-subdued: #{{onSurfaceVariant}} !important;
  --text-bright-accent: #{{primary}} !important;
  --text-positive: #{{success}} !important;
  --text-negative: #{{error}} !important;
  --text-announcement: #{{tertiary}} !important;
  --essential-base: #{{onSurface}} !important;
  --essential-subdued: #{{outline}} !important;
  --essential-bright-accent: #{{primary}} !important;
  --essential-negative: #{{error}} !important;
  --essential-positive: #{{success}} !important;
  --decorative-base: #{{onSurface}} !important;
  --decorative-subdued: #{{outlineVariant}} !important;
}
.encore-bright-accent-set {
  --background-base: #{{primary}} !important;
  --background-highlight: #{{primaryDim}} !important;
  --background-press: #{{primaryDim}} !important;
  --text-base: #{{onPrimary}} !important;
  --essential-base: #{{onPrimary}} !important;
}
/* Main panels, sidebars and the now-playing bar */
.Root__top-container, body { background-color: #{{surfaceContainerLowest}} !important; }
.Root__main-view, .Root__nav-bar, .Root__right-sidebar, .main-view-container, .Root__now-playing-bar,
.main-nowPlayingBar-nowPlayingBar, .main-yourLibraryX-libraryContainer {
  background-color: #{{surface}} !important;
}
.main-topBar-background, .main-entityHeader-backgroundColor, .main-actionBarBackground-background,
.main-home-homeHeader, .x-entityHeader-overlay, .main-entityHeader-overlay, .x-entityHeader-backgroundColor {
  background: transparent !important; background-color: transparent !important; background-image: none !important;
}
.x-progressBar-fillColor, .progress-bar__fg { background-color: #{{primary}} !important; }
.x-progressBar-progressBarBg, .progress-bar__bg { background-color: #{{outlineVariant}} !important; }
::selection { background: color-mix(in oklab, #{{primary}} 40%, transparent); }
