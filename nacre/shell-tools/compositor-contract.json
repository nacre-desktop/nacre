    "hypr/conf/windowrule.lua": [
      {
        "kind": "window-rule",
        "selector": {
          "app_id_regex": "^([Tt]hunar)$"
        },
        "effects": {
          "centered": true,
          "floating": true,
          "size": "70% 75%"
        },
        "id": "nacre-thunar-files"
      },
      {
        "kind": "window-rule",
        "selector": {
          "app_id_regex": "^(org[.]kde[.]dolphin|[Dd]olphin)$"
        },
        "effects": {
          "centered": true,
          "floating": true,
          "size": [
            "monitor_w*0.6",
            "monitor_h*0.75"
          ]
        },
        "id": "nacre-dolphin-files"
      }
    ],
