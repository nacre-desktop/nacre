{
  "version": 1,
  "extensions": {
    "panel.drag": {
      "backend": "hyprland",
      "source": "compositor_backends/hyprland/panel-drag.lua",
      "function": "nacre_panel_drag",
      "purpose": "Owned shell edges pass Super+drag through; ordinary windows keep native press/release movement; detached panels publish bounded native drag events."
    },
    "cursor.session": {
      "backend": "hyprland",
      "source": "compositor_backends/hyprland/session-cursor.lua",
      "function": "apply_session_cursor",
      "purpose": "Apply validated UWSM cursor environment once when the compositor session starts."
    }
  },
  "outputs": {
