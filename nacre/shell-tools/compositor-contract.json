      {
        "kind": "binding",
        "keys": "XF86AudioMute",
        "action": "application.launch",
        "parameters": {
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        },
        "options": {
          "description": "Nacre:mute",
          "locked": true
        }
      },
      {
        "kind": "binding",
        "keys": "XF86AudioLowerVolume",
