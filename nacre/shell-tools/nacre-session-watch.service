[Unit]
Description=Nacre login, resume and display readiness observer
PartOf=graphical-session.target
After=graphical-session.target
[Service]
ExecStart=/usr/bin/python3 %h/.local/share/nacre/shell/tools/session-watch.py watch
Restart=on-failure
RestartSec=3
[Install]
WantedBy=graphical-session.target
