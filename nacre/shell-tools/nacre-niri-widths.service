[Unit]
Description=Nacre proportional tiled widths for X11 applications on Niri
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecCondition=%h/.local/share/nacre/shell/tools/nacre-helper niri_widths --check-session
ExecStart=%h/.local/share/nacre/shell/tools/nacre-helper niri_widths
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
