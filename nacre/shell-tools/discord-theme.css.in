  --neutral-80: color-mix(in oklab, #{{surfaceContainerLowest}} 74%, #{{shadow}}) !important;
  --neutral-81: color-mix(in oklab, #{{surfaceContainerLowest}} 70%, #{{shadow}}) !important;
  --neutral-82: color-mix(in oklab, #{{surfaceContainerLowest}} 67%, #{{shadow}}) !important;
  --neutral-83: color-mix(in oklab, #{{surfaceContainerLowest}} 63%, #{{shadow}}) !important;
  --neutral-84: color-mix(in oklab, #{{surfaceContainerLowest}} 59%, #{{shadow}}) !important;
  --neutral-85: color-mix(in oklab, #{{surfaceContainerLowest}} 56%, #{{shadow}}) !important;
  --neutral-86: color-mix(in oklab, #{{surfaceContainerLowest}} 52%, #{{shadow}}) !important;
  --neutral-87: color-mix(in oklab, #{{surfaceContainerLowest}} 48%, #{{shadow}}) !important;
  --neutral-88: color-mix(in oklab, #{{surfaceContainerLowest}} 44%, #{{shadow}}) !important;
  --neutral-89: color-mix(in oklab, #{{surfaceContainerLowest}} 41%, #{{shadow}}) !important;
  --neutral-90: color-mix(in oklab, #{{surfaceContainerLowest}} 37%, #{{shadow}}) !important;
  --neutral-91: color-mix(in oklab, #{{surfaceContainerLowest}} 33%, #{{shadow}}) !important;
  --neutral-92: color-mix(in oklab, #{{surfaceContainerLowest}} 30%, #{{shadow}}) !important;
  --neutral-93: color-mix(in oklab, #{{surfaceContainerLowest}} 26%, #{{shadow}}) !important;
  --neutral-94: color-mix(in oklab, #{{surfaceContainerLowest}} 22%, #{{shadow}}) !important;
  --neutral-95: color-mix(in oklab, #{{surfaceContainerLowest}} 19%, #{{shadow}}) !important;
  --neutral-96: color-mix(in oklab, #{{surfaceContainerLowest}} 15%, #{{shadow}}) !important;
  --neutral-97: color-mix(in oklab, #{{surfaceContainerLowest}} 11%, #{{shadow}}) !important;
  --neutral-98: color-mix(in oklab, #{{surfaceContainerLowest}} 7%, #{{shadow}}) !important;
  --neutral-99: color-mix(in oklab, #{{surfaceContainerLowest}} 4%, #{{shadow}}) !important;
  --neutral-100: #{{shadow}} !important;
  /* Semantic roles */
  --background-base-lowest: #{{surfaceContainerLowest}} !important;
  --background-base-lower: #{{surface}} !important;
  --background-base-low: #{{surfaceContainerLow}} !important;
  --background-surface-high: #{{surfaceContainer}} !important;
  --background-surface-higher: #{{surfaceContainerHigh}} !important;
  --background-surface-highest: #{{surfaceContainerHighest}} !important;
  --app-frame-background: #{{surfaceContainerLowest}} !important;
  --chat-background: #{{surfaceContainerLow}} !important;
  --chat-background-default: #{{surfaceContainerLow}} !important;
  --panel-bg: #{{surface}} !important;
  --channel-background-default: #{{surface}} !important;
