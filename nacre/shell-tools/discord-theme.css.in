  --neutral-41: color-mix(in oklab, #{{outline}} 69%, #{{outlineVariant}}) !important;
  --neutral-42: color-mix(in oklab, #{{outline}} 62%, #{{outlineVariant}}) !important;
  --neutral-43: color-mix(in oklab, #{{outline}} 54%, #{{outlineVariant}}) !important;
  --neutral-44: color-mix(in oklab, #{{outline}} 46%, #{{outlineVariant}}) !important;
  --neutral-45: color-mix(in oklab, #{{outline}} 38%, #{{outlineVariant}}) !important;
  --neutral-46: color-mix(in oklab, #{{outline}} 31%, #{{outlineVariant}}) !important;
  --neutral-47: color-mix(in oklab, #{{outline}} 23%, #{{outlineVariant}}) !important;
