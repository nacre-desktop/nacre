/**
 * @name Nacre
 * @description Follows the Nacre desktop palette. Generated by Nacre; edits are overwritten.
 * @author Nacre
 * @version 2
 */
/* Discord derives most surfaces from a 100-step neutral scale; remap it onto the palette by role. */
:root,
.theme-dark,
.theme-darker,
.theme-midnight,
.theme-light,
.visual-refresh .theme-dark,
.visual-refresh.theme-dark {
  --neutral-1: #{{onSurface}} !important;
  --neutral-2: color-mix(in oklab, #{{onSurface}} 96%, #{{onSurfaceVariant}}) !important;
  --neutral-3: color-mix(in oklab, #{{onSurface}} 93%, #{{onSurfaceVariant}}) !important;
  --neutral-4: color-mix(in oklab, #{{onSurface}} 89%, #{{onSurfaceVariant}}) !important;
  --neutral-5: color-mix(in oklab, #{{onSurface}} 85%, #{{onSurfaceVariant}}) !important;
  --neutral-6: color-mix(in oklab, #{{onSurface}} 81%, #{{onSurfaceVariant}}) !important;
  --neutral-7: color-mix(in oklab, #{{onSurface}} 78%, #{{onSurfaceVariant}}) !important;
  --neutral-8: color-mix(in oklab, #{{onSurface}} 74%, #{{onSurfaceVariant}}) !important;
  --neutral-9: color-mix(in oklab, #{{onSurface}} 70%, #{{onSurfaceVariant}}) !important;
  --neutral-10: color-mix(in oklab, #{{onSurface}} 67%, #{{onSurfaceVariant}}) !important;
  --neutral-11: color-mix(in oklab, #{{onSurface}} 63%, #{{onSurfaceVariant}}) !important;
  --neutral-12: color-mix(in oklab, #{{onSurface}} 59%, #{{onSurfaceVariant}}) !important;
  --neutral-13: color-mix(in oklab, #{{onSurface}} 56%, #{{onSurfaceVariant}}) !important;
  --neutral-14: color-mix(in oklab, #{{onSurface}} 52%, #{{onSurfaceVariant}}) !important;
  --neutral-15: color-mix(in oklab, #{{onSurface}} 48%, #{{onSurfaceVariant}}) !important;
  --neutral-16: color-mix(in oklab, #{{onSurface}} 44%, #{{onSurfaceVariant}}) !important;
  --neutral-17: color-mix(in oklab, #{{onSurface}} 41%, #{{onSurfaceVariant}}) !important;
  --neutral-18: color-mix(in oklab, #{{onSurface}} 37%, #{{onSurfaceVariant}}) !important;
  --neutral-19: color-mix(in oklab, #{{onSurface}} 33%, #{{onSurfaceVariant}}) !important;
  --neutral-20: color-mix(in oklab, #{{onSurface}} 30%, #{{onSurfaceVariant}}) !important;
  --neutral-21: color-mix(in oklab, #{{onSurface}} 26%, #{{onSurfaceVariant}}) !important;
  --neutral-22: color-mix(in oklab, #{{onSurface}} 22%, #{{onSurfaceVariant}}) !important;
  --neutral-23: color-mix(in oklab, #{{onSurface}} 19%, #{{onSurfaceVariant}}) !important;
  --neutral-24: color-mix(in oklab, #{{onSurface}} 15%, #{{onSurfaceVariant}}) !important;
  --neutral-25: color-mix(in oklab, #{{onSurface}} 11%, #{{onSurfaceVariant}}) !important;
  --neutral-26: color-mix(in oklab, #{{onSurface}} 7%, #{{onSurfaceVariant}}) !important;
  --neutral-27: color-mix(in oklab, #{{onSurface}} 4%, #{{onSurfaceVariant}}) !important;
  --neutral-28: #{{onSurfaceVariant}} !important;
  --neutral-29: color-mix(in oklab, #{{onSurfaceVariant}} 89%, #{{outline}}) !important;
  --neutral-30: color-mix(in oklab, #{{onSurfaceVariant}} 78%, #{{outline}}) !important;
  --neutral-31: color-mix(in oklab, #{{onSurfaceVariant}} 67%, #{{outline}}) !important;
  --neutral-32: color-mix(in oklab, #{{onSurfaceVariant}} 56%, #{{outline}}) !important;
  --neutral-33: color-mix(in oklab, #{{onSurfaceVariant}} 44%, #{{outline}}) !important;
  --neutral-34: color-mix(in oklab, #{{onSurfaceVariant}} 33%, #{{outline}}) !important;
  --neutral-35: color-mix(in oklab, #{{onSurfaceVariant}} 22%, #{{outline}}) !important;
  --neutral-36: color-mix(in oklab, #{{onSurfaceVariant}} 11%, #{{outline}}) !important;
