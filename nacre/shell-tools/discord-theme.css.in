  --text-link: #{{primary}} !important;
  --text-brand: #{{primary}} !important;
  --text-positive: #{{success}} !important;
  --text-feedback-positive: #{{success}} !important;
  --text-danger: #{{error}} !important;
  --text-feedback-critical: #{{error}} !important;
  --brand-experiment: #{{primary}} !important;
