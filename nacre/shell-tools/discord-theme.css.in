/**
 * @name Nacre
 * @description Palette generated by Nacre.
 * @author Nacre
 */
:root,
.theme-dark,
.theme-light,
.theme-darker,
.theme-midnight {
  --background-primary: #{{surface}};
  --background-secondary: #{{surfaceContainerLow}};
  --background-secondary-alt: #{{surfaceContainer}};
  --background-tertiary: #{{surfaceContainerLowest}};
  --background-accent: #{{primaryContainer}};
  --background-floating: #{{surfaceContainerHigh}};
  --background-modifier-hover: #{{surfaceContainerHigh}};
  --background-modifier-active: #{{surfaceContainerHighest}};
  --background-modifier-selected: #{{surfaceContainer}};
  --background-modifier-accent: #{{outlineVariant}};
  --channeltextarea-background: #{{surfaceContainerLow}};
  --input-background: #{{surfaceContainerLow}};
  --text-normal: #{{onSurface}};
  --text-muted: #{{onSurfaceVariant}};
  --text-link: #{{tertiary}};
  --header-primary: #{{onSurface}};
  --header-secondary: #{{onSurfaceVariant}};
  --interactive-normal: #{{onSurfaceVariant}};
  --interactive-hover: #{{onSurface}};
  --interactive-active: #{{onSurface}};
  --interactive-muted: #{{outline}};
  --brand-experiment: #{{primary}};
  --brand-experiment-560: #{{primary}};
  --scrollbar-thin-thumb: #{{outline}};
  --scrollbar-auto-thumb: #{{outline}};
  --scrollbar-auto-track: #{{surfaceContainerLowest}};
  --scrollbar-auto-scrollbar-color-thumb: #{{outline}};
  --scrollbar-auto-scrollbar-color-track: #{{surfaceContainerLowest}};
  --deprecated-card-bg: #{{surfaceContainerLow}};
  --deprecated-text-input-bg: #{{surfaceContainerLow}};
  --deprecated-text-input-border: #{{outlineVariant}};
  --deprecated-text-input-border-hover: #{{outline}};
  --deprecated-text-input-border-disabled: #{{surfaceContainerHigh}};
  --deprecated-text-input-prefix: #{{onSurfaceVariant}};
  --background-base-lowest: #{{surfaceContainerLowest}};
  --background-base-lower: #{{surfaceContainerLow}};
  --background-base-low: #{{surfaceContainer}};
  --background-base: #{{surface}};
  --background-base-high: #{{surfaceContainerHigh}};
  --background-base-highest: #{{surfaceContainerHighest}};
  --background-surface-low: #{{surfaceContainerLow}};
  --background-surface-high: #{{surfaceContainer}};
  --background-surface-higher: #{{surfaceContainerHigh}};
  --background-surface-highest: #{{surfaceContainerHighest}};
  --bg-base-primary: #{{surface}};
  --bg-base-secondary: #{{surfaceContainerLow}};
  --bg-base-tertiary: #{{surfaceContainerLowest}};
  --bg-surface-overlay: #{{surfaceContainerHigh}};
  --bg-mod-subtle: #{{surfaceContainerLow}};
  --bg-mod-normal: #{{surfaceContainer}};
  --bg-mod-strong: #{{surfaceContainerHigh}};
  --text-primary: #{{onSurface}};
  --text-secondary: #{{onSurfaceVariant}};
  --text-tertiary: #{{outline}};
  --text-default: #{{onSurface}};
  --text-strong: #{{onSurface}};
  --text-subtle: #{{onSurfaceVariant}};
  --text-brand: #{{primary}};
  --text-feedback-critical: #{{error}};
  --icon-default: #{{onSurface}};
  --icon-muted: #{{onSurfaceVariant}};
  --brand-500: #{{primary}};
  --brand-560: #{{primary}};
  --brand-600: #{{primaryDim}};
  --input-border: #{{outlineVariant}};
  --input-border-default: #{{outlineVariant}};
  --border-subtle: #{{outlineVariant}};
  --border-strong: #{{outline}};
  --border-focus: #{{primary}};
  --control-primary-background-default: #{{primary}};
  --control-primary-background-hover: #{{primaryDim}};
  --control-primary-border-default: #{{primary}};
  --control-primary-border-hover: #{{primaryDim}};
  --control-primary-text-default: #{{onPrimary}};
  --control-primary-text-hover: #{{onPrimary}};
  --control-secondary-background-default: #{{surfaceContainer}};
  --control-secondary-background-hover: #{{surfaceContainerHigh}};
  --control-secondary-border-default: #{{outlineVariant}};
  --control-secondary-border-hover: #{{outline}};
  --control-secondary-text-default: #{{onSurface}};
  --control-secondary-text-hover: #{{onSurface}};
  --control-icon-only-icon-default: #{{onSurfaceVariant}};
  --control-icon-only-icon-hover: #{{onSurface}};
  --control-icon-only-background-hover: #{{surfaceContainerHigh}};
  --control-icon-only-background-active: #{{surfaceContainerHighest}};
  --control-icon-only-border-hover: #{{outlineVariant}};
  --control-icon-only-border-active: #{{outline}};
  --scrollbar-thin-track: #{{surfaceContainerLowest}};
  --status-danger: #{{error}};
  --status-positive: #{{success}};
  --status-warning: #{{tertiary}};
  --focus-primary: #{{primary}};
}
