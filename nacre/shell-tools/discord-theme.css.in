  --status-online: #{{success}} !important;
  --green-360: #{{success}} !important;
  --red-400: #{{error}} !important;
  --background-mod-subtle: color-mix(in oklab, #{{onSurface}} 8%, transparent) !important;
  --background-mod-muted: color-mix(in oklab, #{{onSurface}} 6%, transparent) !important;
  --background-mod-normal: color-mix(in oklab, #{{onSurface}} 12%, transparent) !important;
