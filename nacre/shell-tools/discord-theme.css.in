  --neutral-53: color-mix(in oklab, #{{outlineVariant}} 50%, #{{surfaceBright}}) !important;
  --neutral-54: color-mix(in oklab, #{{outlineVariant}} 33%, #{{surfaceBright}}) !important;
  --neutral-55: color-mix(in oklab, #{{outlineVariant}} 17%, #{{surfaceBright}}) !important;
  --neutral-56: #{{surfaceBright}} !important;
  --neutral-57: color-mix(in oklab, #{{surfaceBright}} 75%, #{{surfaceContainerHighest}}) !important;
  --neutral-58: color-mix(in oklab, #{{surfaceBright}} 50%, #{{surfaceContainerHighest}}) !important;
  --neutral-59: color-mix(in oklab, #{{surfaceBright}} 25%, #{{surfaceContainerHighest}}) !important;
  --neutral-60: #{{surfaceContainerHighest}} !important;
  --neutral-61: color-mix(in oklab, #{{surfaceContainerHighest}} 50%, #{{surfaceContainerHigh}}) !important;
  --neutral-62: #{{surfaceContainerHigh}} !important;
  --neutral-63: color-mix(in oklab, #{{surfaceContainerHigh}} 50%, #{{surfaceContainer}}) !important;
  --neutral-64: #{{surfaceContainer}} !important;
  --neutral-65: color-mix(in oklab, #{{surfaceContainer}} 50%, #{{surfaceContainerLow}}) !important;
  --neutral-66: #{{surfaceContainerLow}} !important;
  --neutral-67: color-mix(in oklab, #{{surfaceContainerLow}} 67%, #{{surface}}) !important;
  --neutral-68: color-mix(in oklab, #{{surfaceContainerLow}} 33%, #{{surface}}) !important;
  --neutral-69: #{{surface}} !important;
  --neutral-70: color-mix(in oklab, #{{surface}} 75%, #{{surfaceContainerLowest}}) !important;
  --neutral-71: color-mix(in oklab, #{{surface}} 50%, #{{surfaceContainerLowest}}) !important;
  --neutral-72: color-mix(in oklab, #{{surface}} 25%, #{{surfaceContainerLowest}}) !important;
  --neutral-73: #{{surfaceContainerLowest}} !important;
  --neutral-74: color-mix(in oklab, #{{surfaceContainerLowest}} 96%, #{{shadow}}) !important;
  --neutral-75: color-mix(in oklab, #{{surfaceContainerLowest}} 93%, #{{shadow}}) !important;
  --neutral-76: color-mix(in oklab, #{{surfaceContainerLowest}} 89%, #{{shadow}}) !important;
