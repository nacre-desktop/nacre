+#[cfg(test)]
+mod nacre_overview_hover_tests {
+    use super::*;
+
+    #[test]
+    fn hover_is_opt_in_and_only_emitted_on_change() {
+        let server = IpcServer {
+            socket_path: None,
+            event_streams: Rc::new(RefCell::new(Vec::new())),
+            event_stream_state: Rc::new(RefCell::new(EventStreamState::default())),
+            overview_hover: Rc::new(Cell::new(None)),
+        };
+        let mut receivers = Vec::new();
+        for overview_hover in [false, true] {
+            let (events, receiver) = async_channel::bounded(4);
+            let (disconnect, _) = async_channel::bounded(1);
+            server.event_streams.borrow_mut().push(EventStreamSender {
+                overview_hover,
+                events,
+                disconnect,
+            });
+            receivers.push(receiver);
+        }
+        assert!(server.has_overview_hover_clients());
+        server.update_overview_hover(Some(7));
+        assert!(receivers[0].try_recv().is_err());
+        assert!(matches!(
+            receivers[1].try_recv(),
+            Ok(Event::NacreOverviewHoverChanged { id: Some(7) })
+        ));
+        server.update_overview_hover(Some(7));
+        assert!(receivers[1].try_recv().is_err());
+        server.send_event(Event::OverviewOpenedOrClosed { is_open: true });
+        for receiver in &receivers {
+            assert!(matches!(
+                receiver.try_recv(),
+                Ok(Event::OverviewOpenedOrClosed { is_open: true })
+            ));
+        }
+        server.update_overview_hover(None);
+        assert!(receivers[0].try_recv().is_err());
+        assert!(matches!(
+            receivers[1].try_recv(),
+            Ok(Event::NacreOverviewHoverChanged { id: None })
+        ));
+    }
+}
