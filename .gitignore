__pycache__/
*.py[cod]
*.log
*.tmp
*.swp
*.backup*
**/build/
**/dist/
**/*.egg-info/
.venv/
# Host state, images and authentication never belong in this source tree.
*.png
*.jpg
*.jpeg
*.webp
*.kwl
*.salt
auth.json
.env
.env.*

# Generated by Quickshell for this host
.qmlls.ini

# Original CC0 regression artwork; private wallpaper PNGs stay ignored.
!nacre/shell-tools/tests/orient-gallery/images/*.png

# Explicitly licensed bundled Welcome art, with hashes/credits; personal images stay ignored.
!nacre/shell-tools/demo-wallpapers/*.jpg
!nacre/shell-tools/demo-wallpapers/*.png
!nacre/shell-tools/demo-wallpapers/*.webp

# Development-only JavaScript formatter.
node_modules/

!assets/branding/*.png

.ruff_cache/
.pytest_cache/

# Reviewed public documentation screenshots.
!/assets/screenshots/
!/assets/screenshots/*.png
